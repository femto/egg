#!/usr/bin/env ruby
# eggc: the Egg compiler (written in the Spinel-compilable Ruby subset).
#
#   eggc check  FILE.egg            type-check only
#   eggc emit-c FILE.egg [-o OUT.c] print or write the generated C
#   eggc build  FILE.egg [-o EXE]   compile to an executable via $CC (default cc)
#   eggc run    FILE.egg            build to a temp file and run it
#   eggc spec                       print the whole language spec (core, grammar,
#                                   diagnostics) for loading into an AI's context
#   eggc lsp                        language server on stdin/stdout, for editors
#
#   --json   print diagnostics as JSON lines (for tools and AI agents)
#   -g       debug build: #line directives map the C back to the .egg file,
#            and build/run compile with -g -O0, so gdb/lldb break on .egg lines

# The compiler uses `case ... in`; older Rubies (macOS ships 2.6 as
# /usr/bin/ruby) would only report a confusing syntax error.
if RUBY_VERSION < "3.0"
  warn "eggc: needs Ruby 3.0 or newer, but #{RUBY_VERSION} is running (#{RbConfig.ruby})"
  exit 2
end

require "tmpdir"
require_relative "../lib/egg"

USAGE = "usage: eggc (check|emit-c|build|run) FILE.egg [-o OUT] [--json] [-g]\n       eggc (spec|lsp)"

def fail_usage
  warn USAGE
  exit 2
end

if ARGV == ["spec"]
  spec_dir = File.expand_path("../spec", __dir__)
  %w[core.md grammar.ebnf diagnostics.md].each_with_index do |f, i|
    puts unless i.zero?
    puts "===== spec/#{f} ====="
    puts File.read(File.join(spec_dir, f))
  end
  exit 0
end

if ARGV == ["lsp"]
  require_relative "../lib/egg/lsp"
  exit Egg::LSP::Server.new.run
end

args = ARGV.dup
json = !args.delete("--json").nil?
debug = !args.delete("-g").nil?
out_path = nil
if (i = args.index("-o"))
  out_path = args[i + 1]
  fail_usage if out_path.nil?
  args.slice!(i, 2)
end
command = args[0]
path = args[1]
fail_usage if command.nil? || path.nil? || args.length != 2

unless File.exist?(path)
  warn "eggc: cannot read #{path}"
  exit 2
end

result = Egg.compile_to_c(File.read(path), path, debug: debug)
unless result.diagnostics.empty?
  result.diagnostics.each do |d|
    if json
      puts d.to_json_text(path)
    else
      warn d.to_text(path)
    end
  end
  exit 1
end

def build_exe(c_source, c_path, exe_path, debug)
  File.write(c_path, c_source)
  cc = ENV["CC"] || "cc"
  # Columns would be C columns, not .egg ones, so leave them out.
  opt = debug ? ["-g", "-gno-column-info", "-O0"] : ["-O2"]
  ok = system(cc, "-std=c99", *opt, "-o", exe_path, c_path)
  unless ok
    warn "eggc: C compiler '#{cc}' failed"
    exit 1
  end
end

case command
when "check"
  exit 0
when "emit-c"
  if out_path
    File.write(out_path, result.c_source)
  else
    print result.c_source
  end
when "build"
  exe = out_path || File.basename(path, ".egg")
  build_exe(result.c_source, "#{exe}.c", exe, debug)
when "run"
  base = File.join(Dir.tmpdir, "eggc-#{Process.pid}")
  build_exe(result.c_source, "#{base}.c", base, debug)
  ok = system(base)
  status = $?.exitstatus
  File.delete(base) if File.exist?(base)
  File.delete("#{base}.c") if File.exist?("#{base}.c")
  exit(status.nil? ? 1 : status) unless ok
else
  fail_usage
end
