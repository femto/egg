#!/usr/bin/env ruby
# eggc: the Egg compiler (written in the Spinel-compilable Ruby subset).
#
#   eggc check  FILE.egg            type-check only
#   eggc emit-c FILE.egg [-o OUT.c] print or write the generated C
#   eggc build  FILE.egg [-o EXE]   compile to an executable via $CC (default cc)
#   eggc run    FILE.egg [-- ARGS]  build to a temp file and run it, passing it ARGS
#   eggc spec                       print the whole language spec (core, grammar,
#                                   diagnostics) for loading into an AI's context
#   eggc lsp                        language server on stdin/stdout, for editors
#   eggc --version                  print eggc's version
#
#   --json   print diagnostics as JSON lines (for tools and AI agents)
#   --release  build/run: let the C compiler optimize (-O2). Without it they
#            compile with -O0, which is several times faster to build and
#            slower to run, as Zig, Rust and Crystal build by default
#   -g       debug build: #line directives map the C back to the .egg file,
#            and build/run compile with -g, so gdb/lldb break on .egg lines
#   -l LIB   build/run: also link the C library LIB (as `link "LIB"` in a file)
#   -L DIR   build/run: look for libraries in DIR too
#   --pkg NAME=DIR  the package NAME is in DIR: @import("NAME") is
#            DIR/NAME.egg and @import("NAME/x") is DIR/x.egg. The package
#            manager, clutch, passes one per dependency (`clutch flags`)

# The compiler uses `case ... in`; older Rubies (macOS ships 2.6 as
# /usr/bin/ruby) would only report a confusing syntax error.
if RUBY_VERSION < "3.0"
  warn "eggc: needs Ruby 3.0 or newer, but #{RUBY_VERSION} is running (#{RbConfig.ruby})"
  exit 2
end

require "tmpdir"
require_relative "../lib/egg"

USAGE = "usage: eggc (check|emit-c|build|run) FILE.egg [-o OUT] [--json] [--release] [-g] [-l LIB] [-L DIR] [--pkg NAME=DIR] [-- ARGS]\n       eggc (spec|lsp|--version)"

def fail_usage
  warn USAGE
  exit 2
end

if ARGV == ["--version"] || ARGV == ["version"]
  puts "eggc #{Egg.version_text}"
  exit 0
end

if ARGV == ["spec"]
  spec_dir = Egg.home_dir("spec", File.expand_path("../spec", __dir__))
  %w[core.md grammar.ebnf diagnostics.md].each_with_index do |f, i|
    puts unless i.zero?
    puts "===== spec/#{f} ====="
    puts File.read(File.join(spec_dir, f))
  end
  exit 0
end

if ARGV == ["lsp"]
  require_relative "../lib/egg/lsp"
  exit Egg::LSP::Server.new.run
end

args = ARGV.dup
# After --, everything belongs to the program: eggc run FILE.egg -- -g -o x
program_args = []
if (i = args.index("--"))
  program_args = args[(i + 1)..]
  args = args[0...i]
end
json = !args.delete("--json").nil?
debug = !args.delete("-g").nil?
release = !args.delete("--release").nil?
out_path = nil
if (i = args.index("-o"))
  out_path = args[i + 1]
  fail_usage if out_path.nil?
  args.slice!(i, 2)
end
# -l LIB and -L DIR, also written -lLIB and -LDIR, in order.
libs = []
lib_dirs = []
i = 0
while i < args.length
  a = args[i]
  if a == "-l" || a == "-L"
    fail_usage if args[i + 1].nil?
    (a == "-l" ? libs : lib_dirs) << args[i + 1]
    args.slice!(i, 2)
  elsif a.start_with?("-l") || a.start_with?("-L")
    (a.start_with?("-l") ? libs : lib_dirs) << a[2..]
    args.slice!(i, 1)
  else
    i += 1
  end
end
# --pkg NAME=DIR, also written --pkg=NAME=DIR.
pkgs = {}
i = 0
while i < args.length
  a = args[i]
  if a == "--pkg" || a.start_with?("--pkg=")
    spec = a == "--pkg" ? args[i + 1] : a[6..]
    fail_usage if spec.nil?
    name, dir = spec.split("=", 2)
    unless name.to_s.match?(/\A[A-Za-z_][A-Za-z0-9_]*\z/) && !dir.to_s.empty?
      warn "eggc: --pkg wants NAME=DIR with NAME a plain name such as http, not #{spec.inspect}"
      exit 2
    end
    if name == "std"
      warn "eggc: --pkg cannot name a package std, the standard library's name"
      exit 2
    end
    if pkgs.key?(name)
      warn "eggc: --pkg gives the package #{name} twice"
      exit 2
    end
    unless File.directory?(dir)
      warn "eggc: --pkg #{name}=#{dir}: no such directory"
      exit 2
    end
    pkgs[name] = dir
    args.slice!(i, a == "--pkg" ? 2 : 1)
  else
    i += 1
  end
end
command = args[0]
path = args[1]
fail_usage if command.nil? || path.nil? || args.length != 2
fail_usage if ARGV.include?("--") && command != "run"

unless File.exist?(path)
  warn "eggc: cannot read #{path}"
  exit 2
end

result = Egg.compile_to_c(File.read(path), path, debug: debug, pkgs: pkgs)
unless result.diagnostics.empty?
  result.diagnostics.each do |d|
    if json
      puts d.to_json_text(path)
    else
      warn d.to_text(path)
    end
  end
  exit 1
end

# links: library flags, after the source so the linker sees what it needs.
def build_exe(c_source, c_path, exe_path, debug, release, links)
  File.write(c_path, c_source)
  cc = ENV["CC"] || "cc"
  opt = [release ? "-O2" : "-O0"]
  # Columns would be C columns, not .egg ones, so leave them out.
  opt += ["-g", "-gno-column-info"] if debug
  ok = system(cc, "-std=c99", *opt, "-o", exe_path, c_path, *links)
  unless ok
    warn "eggc: C compiler '#{cc}' failed"
    exit 1
  end
end

links = lib_dirs.map { |d| "-L#{d}" } + (result.links + libs).uniq.map { |l| "-l#{l}" }

case command
when "check"
  exit 0
when "emit-c"
  if out_path
    File.write(out_path, result.c_source)
  else
    print result.c_source
  end
when "build"
  exe = out_path || File.basename(path, ".egg")
  build_exe(result.c_source, "#{exe}.c", exe, debug, release, links)
when "run"
  base = File.join(Dir.tmpdir, "eggc-#{Process.pid}")
  build_exe(result.c_source, "#{base}.c", base, debug, release, links)
  ok = system([base, base], *program_args)
  status = $?.exitstatus
  File.delete(base) if File.exist?(base)
  File.delete("#{base}.c") if File.exist?("#{base}.c")
  exit(status.nil? ? 1 : status) unless ok
else
  fail_usage
end
