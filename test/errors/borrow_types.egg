// sink only on what owns something; a borrowed temporary would never be
// freed; deinit must take self by sink.
uses alloc, io

fn twice(sink n: i64) i64 {
    return 2 * n
}

fn count(b: Buf(i64)) i64 {
    return @len(b)
}

const Res = owned struct {
    id: i64

    fn deinit(self: Res) void {
        out_of(self.id)
    }

    fn id_of(self: Res) i64 {
        return self.id
    }
}

fn out_of(id: i64) void {
    if (id < 0) {
        return
    }
}

const Bag = struct {
    data: Buf(i64)

    fn consume(sink self: Bag, a: Allocator, xs: []i64) void {
        a.free(self.data)
        if (@len(xs) < 0) {
            return
        }
    }
}

fn make() Res {
    return Res{ .id = 1 }
}

fn main(io: Io, a: Allocator) void {
    io.print(twice(2))
    io.print(count(a.alloc(2, 0)))
    io.print(make().id_of())
    io.print(count(.empty))
    const bag = Bag{ .data = a.alloc(2, 0) }
    bag.consume(a, bag.data[0..])
}
// error: E145 @5
// error: E143 @16
// error: E133 @48
// error: E133 @49
// error: E117 @52
