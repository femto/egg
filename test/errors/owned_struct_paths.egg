// An owned struct must be ended exactly once, on every path.
uses alloc, io

const conn = @import("lib/conn.egg")

fn leak(io: Io) void {
    var c = conn.open(1)
    c.send(io, 1)
}

fn twice(io: Io) void {
    const c = conn.open(1)
    const d = c
    d.close(io)
    c.close(io)
}

fn maybe(io: Io, b: bool) void {
    const c = conn.open(1)
    if (b) {
        c.close(io)
    }
}

fn overwrite(io: Io) void {
    var c = conn.open(1)
    c = conn.open(2)
    c.close(io)
}

fn main(io: Io) void {
    leak(io)
    twice(io)
    maybe(io, true)
    overwrite(io)
}
// error: E135 @7
// error: E136 @15
// error: E134 @20
// error: E135 @27
