uses alloc, thread

fn leak(threads: Threads) void {
    const rx = threads.channel(i64, 1)
    _ = rx.recv() orelse 0
}

fn twice(threads: Threads) void {
    const rx = threads.channel(i64, 1)
    rx.close()
    rx.close()
}

fn moved(a: Allocator, tx: Sender(Buf(u8))) void {
    const b: Buf(u8) = a.alloc(1, 0)
    tx.send(b)
    a.free(b)
}

