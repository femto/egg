// An inout slice is written &x[lo..hi] of a mutable place, and only its
// elements change.
uses io, alloc

fn fill(inout xs: []i64, v: i64) void {
    xs[0] = v
}

fn reset(inout xs: []i64, ys: []i64) void {
    xs = ys
    ys[0] = 1
    fill(&ys[0..], 2)
}

fn both(inout xs: []i64, inout ys: []i64) void {
    fill(&xs[0..], @len(ys))
}

fn own(inout bs: []Buf(i64)) void {
    _ = @len(bs)
}

fn main(io: Io, a: Allocator) void {
    const arr = [2]i64{ 1, 2 }
    fill(&arr[0..], 0)
    var v = [2]i64{ 1, 2 }
    fill(&v, 0)
    fill(v[0..], 0)
    fill(&"ab"[0..], 0)
    both(&v[0..1], &v[1..])
    reset(&v[0..], v[0..])
    io.print(v[0])
}
