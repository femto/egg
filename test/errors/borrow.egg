// Local borrows: what the checker refuses.
uses alloc, io

const Db = struct {
    name: Buf(u8)
    hits: i64
}

fn make(a: Allocator) Db {
    return Db{ .name = a.concat("x", "y"), .hits = 0 }
}

fn main(io: Io, a: Allocator) void {
    const d = make(a)
    defer a.free(d)
    const t = &make(a)
    var v = &d.hits
    inout w = &d.hits
    const r = &d
    r.hits = 1
    var e = make(a)
    defer a.free(e)
    inout u = &e.hits
    io.print(u, v, w, t.hits)
    const s = "text"
    const q = &s
    io.print(q)
}

