// Owned unions: what the checker refuses before ownership is followed.
uses alloc

const Msg = union(enum) { text: Buf(u8), ping }

const File = owned struct {
    fd: i64
}

const Handle = union(enum) { file: File, none }

const Conn = owned struct {
    id: i64

    fn deinit(sink self: Conn) void {
        @forget(self)
    }
}

const Slot = union(enum) { conn: Conn, free }

fn make(a: Allocator) Msg {
    return Msg{ .text = a.concat("a", "b") }
}

fn main(a: Allocator) void {
    switch (make(a)) {
        else => {}
    }
    const hs: Buf(Handle) = .empty
    a.free(hs)
    const ms = a.alloc(2, make(a))
    a.free(ms)
    const ss = a.alloc(2, Slot.free)     // owns nothing: fine
    a.free(ss)
}

