// Bitwise operators take integers, both of one type; a shift takes any
// integer amount, and a literal one must be below the width.
uses io

fn main(io: Io) void {
    const x: u8 = 1
    io.print(x << 8)
    io.print(x >> -1)
    io.print(1.5 & 2)
    io.print(~true)
    io.print(x & @as(u16, 1))
    io.print(1 << 2.0)
    io.print("a" | "b")
    const y: u8 = 0x100
    io.print(y)
}
// error: E003 @7
// error: E003 @8
// error: E103 @9
// error: E103 @10
// error: E103 @11
// error: E103 @12
// error: E103 @13
// error: E003 @14
