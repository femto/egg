// The branches of an if with a value have one type, which is a value;
// the condition is a bool; and it cannot lend an owned value.
uses io, alloc

fn n(b: Buf(i64)) i64 {
    return @len(b)
}

fn main(io: Io, a: Allocator) void {
    const x: i64 = 1
    io.print(if (x > 0) 1 else "s")
    const y = if (x > 0) io.print(1) else io.print(2)
    io.print(if (x) 1 else 2)
    const want: str = if (x > 0) "a" else 3
    io.print(want)
    const b: Buf(i64) = a.alloc(2, 0)
    defer a.free(b)
    io.print(n(if (x > 0) b else b))
}

