// An owned struct from another file cannot be built, dropped, changed
// field by field, freed or kept in an array or buffer.
uses alloc, io

const conn = @import("lib/conn.egg")

const Pair = struct { c: conn.Conn, n: i64 }

fn forge(io: Io) void {
    const c = conn.Conn{ .id = 9 }
    @drop(c)
    io.print(0)
}

fn freed(a: Allocator) void {
    const p = Pair{ .c = conn.open(1), .n = 0 }
    a.free(p)
}

fn arrays(xs: [2]conn.Conn) void {
}

fn bufs(b: Buf(Pair)) void {
}

fn plain(a: Allocator) void {
    const b = a.alloc(2, 0)
    @drop(b)
}

fn bump(inout n: i64) void {
    n = n + 1
}

fn fields(io: Io) void {
    var c = conn.open(1)
    c.id = 99
    bump(&c.id)
    const old = @replace(&c.id, 5)
    io.print(old)
    c.close(io)
}

fn literal(io: Io) void {
    const xs = [1]conn.Conn{ conn.open(1) }
    io.print(@len(xs))
}

fn main(io: Io, a: Allocator) void {
    forge(io)
    freed(a)
    plain(a)
    fields(io)
    literal(io)
}
