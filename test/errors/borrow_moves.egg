// Local borrows last until their last use, and never own what they name.
uses alloc, io

const Db = struct {
    name: Buf(u8)
    hits: i64
}

const File = owned struct {
    fd: i64
}

fn make(a: Allocator) Db {
    return Db{ .name = a.concat("x", "y"), .hits = 0 }
}

fn main(io: Io, a: Allocator) void {
    const d = make(a)
    const n = &d.name
    a.free(d)
    io.print(n)
    var e = make(a)
    inout w = &e
    io.print(e.hits)
    w.hits = 2
    const r = &e.name
    a.free(r)
    a.free(e)
    var f = make(a)
    inout x = &f.hits
    const y = &f.hits
    x = 3
    io.print(y)
    a.free(f)
    const g = File{ .fd = 1 }
    const h = &g
    @forget(h)
    @forget(g)
}

// error: E149 @20
