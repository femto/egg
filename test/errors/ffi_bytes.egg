// @strPtr takes text, @bufPtr a buffer, and @sliceFromPtr makes a slice
// only where a slice may be. A buffer they point into must be a variable.
uses alloc
allow unsafe

fn main(a: Allocator) void {
    const n: i64 = 5
    _ = @strPtr(n)
    _ = @bufPtr("text")
    const b: Buf(u8) = a.alloc(4, 0)
    defer a.free(b)
    var s = @sliceFromPtr(@bufPtr(b), 2)
    _ = @sliceFromPtr(n, 2)
    _ = @strPtr(a.concat("x", "y"))
    _ = @bufPtr(a.alloc(2, 0))
}

// error: E103 @8
