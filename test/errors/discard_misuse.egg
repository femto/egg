// _ = drops only a value: not void, not a type, not an error union, nothing owned.
uses io, alloc

fn may(fail: bool) !i64 {
    if (fail) {
        return error.Bad
    }
    return 1
}

fn main(io: Io, a: Allocator) void {
    _ = may(true)
    _ = io.print(1)
    _ = a.alloc(2, 0)
    var bs: Buf(Buf(i64)) = .empty
    defer a.free(bs)
    _ = a.pop(&bs)
    noisy()
    _ = i64
    a.alloc(2, 0)
    done()
}

fn done() !void {
    return
}

fn noisy() i64 {
    return 1
}

// error: E113 @12
