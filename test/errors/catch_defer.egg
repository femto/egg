// A try nested in a loop of a catch block cannot hide in a defer; a
// newline may follow |e|; an unused |e| is E110, |_| is not.
uses io
fn f(x: i64) !i64 {
    if (x == 0) { return error.Zero }
    return x
}
fn g() !void {
    return
}
fn h(io: Io) !void {
    defer g() catch {
        while ((try f(1)) > 5) {
            io.print(1)
        }
    }
    const v = f(2) catch |e|
        0
    io.print(v)
}
fn main(io: Io) void {
    h(io) catch |_| {
        io.print(0)
    }
}
// error: E118 @12
// error: E110 @17
