// Misusing optionals and orelse.
uses alloc, io

fn bad_err(x: ?!i64) void {
}

fn not_opt(io: Io) void {
    const n = 3
    io.print(n orelse 4)
}

fn wrong_fallback(x: ?i64) i64 {
    return x orelse true
}

fn in_defer(io: Io, x: ?i64) void {
    defer io.print(x orelse return)
    io.print(1)
}

fn owned_local(a: Allocator) void {
    var b: Buf(Buf(i64)) = .empty
    const top: ?Buf(i64) = a.pop(&b)
    a.free(b)
}

fn ignored(a: Allocator) void {
    var b: Buf(i64) = .empty
    a.pop(&b)
    a.free(b)
}

fn print_opt(io: Io, x: ?i64) void {
    io.print(x)
}

const Holder = struct {
    b: Buf(i64)
}

fn push_struct(a: Allocator) void {
    var h = Holder{ .b = .empty }
    a.push(&h, 1)
    a.free(h)
}

fn clear(inout x: ?i64) void {
    x = null
}

fn wrap_inout() void {
    var v: i64 = 3
    clear(&v)
}

fn main() void {
}
