// Misusing buffers and the allocator's buffer methods.
uses alloc, io

const Buf = struct { x: i64 }

fn Buf(n: i64) i64 {
    return n
}

fn sum(xs: []i64, n: i64) i64 {
    return n
}

fn keep(sink b: Buf(i64), n: i64) void {
}

fn main(io: Io, a: Allocator) void {
    var b = a.alloc(3, 0)
    a.free(7)
    a.resize(b, 4, 0)
    keep(b, @len(b))
    const c: Buf = 1
    const d = a.alloc(2, true)
    const e = a.alloc(2, 0)
    io.print(sum(e[0..], 1) + d[0])
    io.print(e == e)
    a.free(e)
}

