// error: E122 @26
// error: E155 @33
// error: E155 @48
uses alloc, net, thread

const P = struct { x: i64 }

// Keys are text or integers; values what a Shared may hold.
fn float_key(m: ConcurrentMap(f64, i64)) void {}
fn struct_key(m: ConcurrentMap(P, i64)) void {}
fn socket_value(m: ConcurrentMap(str, TcpConn)) void {}
fn map_in_shared(s: Shared(ConcurrentMap(str, i64))) void {}

fn main(a: Allocator, threads: Threads) void {
    const m = threads.map(str, P)
    _ = m.add(a, "x", 1)                                // add is for i64 values
    _ = m.put_if(a, "x", P{ .x = 1 }, P{ .x = 2 })      // P has no ==
    _ = threads.map(str, i64).count()                  // a temporary, never closed
    m.push(1)
    m.close()
}

// A generic struct is checked once its fields are known.
fn Node(comptime T: type) type {
    return struct {
        kids: ConcurrentMap(i64, @This())
        v: T
    }
}
fn nodes(n: Node(i64)) void {}

// MapEntry's value is decided once the struct holding it is complete: a
// Shared(Tree(i64)), so Tree holds a Shared and cannot be a map's value.
fn Tree(comptime T: type) type {
    return struct {
        seen: Buf(MapEntry(i64, @This()))
        name: Buf(u8)
        v: T
    }
}
fn trees(m: ConcurrentMap(i64, Tree(i64))) void {}
