// An if with a value may yield a slice (viewing what either branch does),
// but its branches must have one type.

fn both(a: []u8, b: []u8, c: bool) i64 {
    const s = if (c) a else b
    return @len(s)
}

fn mixed(a: []u8, c: bool) i64 {
    const s = if (c) a else 5
    return s
}

fn local(c: bool) []u8 {
    const xs = [2]u8{ 1, 2 }
    return if (c) xs[0..] else ""
}

fn main(io: Io) void {
    io.print(both("ab", "c", true) + mixed("ab", true))
}

