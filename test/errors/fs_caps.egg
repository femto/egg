uses io

fn save(files: Fs) void {
    // no `uses fs`
    files.write("/tmp/x", "y") catch {
        return
    }
}

fn load(files: Fs, a: Allocator) void {
    const b = files.read(a, "/tmp/x") catch {
        return
    }
    a.free(b)
}

fn main(out: Io, files: Fs, a: Allocator) void {
    save(files)
    load(files, a)
    out.print(1)
}
