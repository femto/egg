uses io

fn save(files: Fs) void {
    // no `uses fs`
    files.write("x.txt", "y") catch {
        return
    }
}

fn load(files: Fs, a: Allocator) void {
    const b = files.read(a, "x.txt") catch {
        return
    }
    a.free(b)
}

fn main(io: Io, files: Fs, a: Allocator) void {
    save(files)
    load(files, a)
    io.print(1)
}
