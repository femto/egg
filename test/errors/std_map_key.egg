// A HashMap key hashes and compares by its canonical bytes, which a float
// does not have (NaN is not equal to itself): E157, pointing at @floatBits.
uses alloc

const map = @import("std/map")

fn main(a: Allocator) void {
    const m = map.HashMap(f64, i64).init()
    a.free(m)
}
// error: E157 @std/map.egg:56
