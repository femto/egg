uses alloc, thread

fn borrow(b: Buf(i64)) void { _ = @len(b) }
fn view(xs: []i64) void { _ = @len(xs) }
fn change(inout b: Buf(i64)) void { b[0] = 1 }
fn answer() i64 { return 1 }
fn take(a: Allocator, sink b: Buf(i64)) void { a.free(b) }

fn main(a: Allocator, threads: Threads) void {
    var b = a.alloc(1, 0)
    threads.spawn(borrow, b).join()
    threads.spawn(view, b[0..]).join()
    threads.spawn(change, &b).join()
    threads.spawn(answer).join()
    threads.spawn(1).join()
    threads.spawn().join()
    a.free(b)
}
