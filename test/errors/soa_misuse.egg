uses alloc, io

const P = struct { x: i64 }
const E = struct {}
const B = struct { b: Buf(u8), n: i64 }
const N = struct { kids: Soa(N), n: i64 }
const U = union(enum) { a: i64, b }

fn main(io: Io, a: Allocator) void {
    const xs = [2]i64{ 1, 2 }
    const s0: Soa(P) = .empty
    const s1: Soa(i64) = .empty
    const s2: Soa(E) = .empty
