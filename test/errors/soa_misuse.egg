fn make(a: Allocator) Soa(P) {
    var s: Soa(P) = .empty
    s.append(a, P{ .x = 1 })
    return s
}

fn step(inout xs: []i64, vs: []i64) void {
    xs[0] = vs[0]
}

fn twice(inout s: Soa(P)) void {
    step(&s.items(.x), s.items(.x))
}
