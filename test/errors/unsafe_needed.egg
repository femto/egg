// error: E131 @10
// error: E121 @11
// error: E131 @13
// Pointers can be made (a.create) and held anywhere, but using them needs
// `allow unsafe`.
uses io, alloc

fn main(io: Io, a: Allocator) void {
    const p = a.create(5)
    io.print(p.*)
    const q = &p
    io.print(p == null)
    io.print(@intFromPtr(p))
}
