// error: E111 @8
// error: E121 @10
// error: E103 @11
// error: E104 @12
uses alloc, io

fn main(io: Io, a: Allocator) !void {
    var line: Buf(u8) = .empty
    var nums: Buf(i64) = .empty
    const x = try io.read_line(a, line)
    const y = try io.read_line(a, &nums)
    const z = try io.read_all()
    io.print(x, y, z)
    a.free(line)
    a.free(nums)
}
