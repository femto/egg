{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug .egg (lldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "eggc build -g"
    },
    {
      "name": "Debug .egg (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "gdb",
      "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "eggc build -g"
    }
  ]
}
