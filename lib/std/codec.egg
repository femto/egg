// std/codec: Base64 (standard and URL-safe), hex, and the percent
// escaping of URLs and forms. Each encoder appends to a Buf(u8) it is
// given; decoders say false for input that is not in their encoding.
// const codec = @import("std/codec")
// codec.base64_encode(a, &out, "hi") appends "aGk=".
uses alloc

const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const HEX = "0123456789abcdef"

// Base64 with padding (RFC 4648), at the end of out.
fn base64_encode(a: Allocator, inout out: Buf(u8), s: []u8) void {
    var i = 0
    while (i + 2 < @len(s)) {
        const n = (@as(i64, s[i]) << 16) | (@as(i64, s[i + 1]) << 8) | @as(i64, s[i + 2])
        a.push(&out, B64[(n >> 18) & 63])
        a.push(&out, B64[(n >> 12) & 63])
        a.push(&out, B64[(n >> 6) & 63])
        a.push(&out, B64[n & 63])
        i = i + 3
    }
    const rest = @len(s) - i
    if (rest == 1) {
        const n = @as(i64, s[i]) << 16
        a.push(&out, B64[(n >> 18) & 63])
        a.push(&out, B64[(n >> 12) & 63])
        a.append_str(&out, "==")
    } else if (rest == 2) {
        const n = (@as(i64, s[i]) << 16) | (@as(i64, s[i + 1]) << 8)
        a.push(&out, B64[(n >> 18) & 63])
        a.push(&out, B64[(n >> 12) & 63])
        a.push(&out, B64[(n >> 6) & 63])
        a.push(&out, '=')
    }
}

// URL-safe Base64 without padding, at the end of out.
fn base64url_encode(a: Allocator, inout out: Buf(u8), s: []u8) void {
    const start = @len(out)
    base64_encode(a, &out, s)
    var n = @len(out)
    while (n > start and out[n - 1] == '=') {
        n = n - 1
    }
    a.resize(&out, n, 0)
    var i = start
    while (i < n) {
        if (out[i] == '+') {
            out[i] = '-'
        } else if (out[i] == '/') {
            out[i] = '_'
        }
        i = i + 1
    }
}

// The value of one Base64 character, either alphabet, or -1.
fn b64_value(c: u8) i64 {
    if (c >= 'A' and c <= 'Z') {
        return @as(i64, c - 'A')
    }
    if (c >= 'a' and c <= 'z') {
        return @as(i64, c - 'a') + 26
    }
    if (c >= '0' and c <= '9') {
        return @as(i64, c - '0') + 52
    }
    if (c == '+' or c == '-') {
        return 62
    }
    if (c == '/' or c == '_') {
        return 63
    }
    return -1
}

// Base64 in either alphabet, padded or not, at the end of out: false if s
// is not Base64.
fn base64_decode(a: Allocator, inout out: Buf(u8), s: []u8) bool {
    var n = @len(s)
    while (n > 0 and s[n - 1] == '=') {
        n = n - 1
    }
    if (@len(s) - n > 2 or n % 4 == 1) {
        return false
    }
    var acc = 0
    var bits = 0
    for (s[0..n]) |c| {
        const v = b64_value(c)
        if (v < 0) {
            return false
        }
        acc = ((acc << 6) | v) & 0xFFFFFF
        bits = bits + 6
        if (bits >= 8) {
            bits = bits - 8
            a.push(&out, @as(u8, (acc >> bits) & 255))
        }
    }
    return true
}

fn hex_encode(a: Allocator, inout out: Buf(u8), s: []u8) void {
    for (s) |c| {
        a.push(&out, HEX[@as(i64, c >> 4)])
        a.push(&out, HEX[@as(i64, c & 15)])
    }
}

fn hex_value(c: u8) i64 {
    if (c >= '0' and c <= '9') {
        return @as(i64, c - '0')
    }
    if (c >= 'a' and c <= 'f') {
        return @as(i64, c - 'a') + 10
    }
    if (c >= 'A' and c <= 'F') {
        return @as(i64, c - 'A') + 10
    }
    return -1
}

// Form (application/x-www-form-urlencoded) unescaping, at the end of out:
// + is a space and %XX a byte; a malformed % stays as it is.
fn unescape(a: Allocator, inout out: Buf(u8), s: []u8) void {
    var i = 0
    while (i < @len(s)) {
        const c = s[i]
        if (c == '+') {
            a.push(&out, ' ')
        } else if (c == '%' and i + 2 < @len(s) and hex_value(s[i + 1]) >= 0 and hex_value(s[i + 2]) >= 0) {
            a.push(&out, @as(u8, hex_value(s[i + 1]) * 16 + hex_value(s[i + 2])))
            i = i + 2
        } else {
            a.push(&out, c)
        }
        i = i + 1
    }
}

// Form escaping, at the end of out: letters, digits and *-._ stay, a space
// is +, anything else %XX (as browsers encode a form field).
fn escape(a: Allocator, inout out: Buf(u8), s: []u8) void {
    for (s) |c| {
        if ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '*' or c == '-' or c == '.' or c == '_') {
            a.push(&out, c)
        } else if (c == ' ') {
            a.push(&out, '+')
        } else {
            a.push(&out, '%')
            a.push(&out, "0123456789ABCDEF"[@as(i64, c >> 4)])
            a.push(&out, "0123456789ABCDEF"[@as(i64, c & 15)])
        }
    }
}

// URL-safe Base64 with padding (Base64.urlsafe_encode64), at the end of out.
fn base64url_padded(a: Allocator, inout out: Buf(u8), s: []u8) void {
    const start = @len(out)
    base64_encode(a, &out, s)
    var i = start
    while (i < @len(out)) {
        if (out[i] == '+') {
            out[i] = '-'
        } else if (out[i] == '/') {
            out[i] = '_'
        }
        i = i + 1
    }
}
