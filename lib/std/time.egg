// std/time: the calendar, in UTC. An instant is an i64 of nanoseconds since
// 1970-01-01 UTC, as clock.now() gives it, which reaches from 1677 to 2262;
// a DateTime is one taken apart into year, month, day and time of day, in
// the proleptic Gregorian calendar and without leap seconds.
// const time = @import("std/time")
// time.utc(0) is 1970-01-01 00:00:00, a Thursday;
// time.append_rfc3339(a, &out, 0, 0) appends "1970-01-01T00:00:00Z";
// time.append_http_date(a, &out, 0) appends "Thu, 01 Jan 1970 00:00:00 GMT";
// time.parse_rfc3339("1970-01-01T08:00:00+08:00") is 0.
//
// A Zone gives the offset from UTC in force at an instant, from the
// system's time zone database (TZif files, RFC 8536), the local zone or a
// POSIX TZ rule:
// const z = try time.load(fs, a, "America/New_York")
// defer a.free(z)
// z.at(ns) is the date and time there; z.offset(ns) the seconds east of
// UTC, for time.append_rfc3339; z.instant(t) the instant of a local time.
uses alloc, args, fs

// Durations, in nanoseconds.
const NANOSECOND = 1
const MICROSECOND = 1000
const MILLISECOND = 1000000
const SECOND = 1000000000
const MINUTE = 60000000000
const HOUR = 3600000000000
const DAY = 86400000000000

const Weekday = enum { sunday, monday, tuesday, wednesday, thursday, friday, saturday }

const DAY_NAMES = "SunMonTueWedThuFriSat"
const MONTH_NAMES = "JanFebMarAprMayJunJulAugSepOctNovDec"

// A date and time of day, with no time zone of its own: month 1 to 12,
// day 1 to 31, hour 0 to 23, minute and second 0 to 59, nano 0 to
// 999999999.
const DateTime = struct {
    year: i64
    month: i64
    day: i64
    hour: i64
    minute: i64
    second: i64
    nano: i64

    // The weekday and the day of the year are those of the date the fields
    // carry over to, as unix() does: 2025-13-01 is a Thursday, day 1.
    fn weekday(self: DateTime) Weekday {
        const days = [7]Weekday{ .sunday, .monday, .tuesday, .wednesday, .thursday, .friday, .saturday }
        return days[weekday_index(floor_div(self.unix(), 86400))]
    }

    // 1 for January 1st, up to 366.
    fn yearday(self: DateTime) i64 {
        const days = floor_div(self.unix(), 86400)
        return days - epoch_days(civil(days).year, 1, 1) + 1
    }

    // Whether every field is in its range, the day in its month.
    fn valid(self: DateTime) bool {
        return self.month >= 1 and self.month <= 12 and self.day >= 1 and self.day <= days_in_month(self.year, self.month) and self.hour >= 0 and self.hour <= 23 and self.minute >= 0 and self.minute <= 59 and self.second >= 0 and self.second <= 59 and self.nano >= 0 and self.nano < SECOND
    }

    // Seconds since 1970-01-01 UTC, taking the fields as UTC. Fields out of
    // their range carry over, as in Go: month 13 is January of the next
    // year, day 0 the last day of the month before.
    fn unix(self: DateTime) i64 {
        return epoch_days(self.year, self.month, self.day) * 86400 + self.hour * 3600 + self.minute * 60 + self.second + floor_div(self.nano, SECOND)
    }

    // The instant, in nanoseconds; null outside what an i64 holds, and for
    // fields so far out of range (a year past a billion, a day past 10^12)
    // that adding them up could overflow.
    fn unix_ns(self: DateTime) ?i64 {
        if (!self.fits()) {
            return null
        }
        return from_parts(self.unix(), floor_mod(self.nano, SECOND))
    }

    // Whether the fields are near enough their ranges that unix() cannot
    // overflow.
    fn fits(self: DateTime) bool {
        const big = 1000000000000
        return within(self.year, 1000000000) and within(self.month, 1000000000) and within(self.day, big) and within(self.hour, big) and within(self.minute, big) and within(self.second, big)
    }
}

fn floor_div(a: i64, b: i64) i64 {
    const q = a / b
    return if (a % b != 0 and (a < 0) != (b < 0)) q - 1 else q
}

// Not a - floor_div(a, b) * b, which can overflow when a is near the ends.
fn floor_mod(a: i64, b: i64) i64 {
    const r = a % b
    return if (r != 0 and (r < 0) != (b < 0)) r + b else r
}

fn within(x: i64, bound: i64) bool {
    return x >= 0 - bound and x <= bound
}

fn is_leap(year: i64) bool {
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
}

fn days_in_month(year: i64, month: i64) i64 {
    if (month == 2) {
        return if (is_leap(year)) 29 else 28
    }
    if (month == 4 or month == 6 or month == 9 or month == 11) {
        return 30
    }
    return 31
}

// Days from 1970-01-01 to the date, negative before it (Howard Hinnant's
// days_from_civil). A month out of 1 to 12 carries into the year, a day
// out of its month into the months around it.
fn epoch_days(year: i64, month: i64, day: i64) i64 {
    var y = year + floor_div(month - 1, 12)
    const m = floor_mod(month - 1, 12) + 1
    if (m <= 2) {
        y = y - 1
    }
    // Eras of 400 years, which all have 146097 days; March starts the year
    // so that February's leap day comes last.
    const era = floor_div(y, 400)
    const yoe = y - era * 400
    const mp = if (m > 2) m - 3 else m + 9
    const doy = (153 * mp + 2) / 5 + day - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// 0 for Sunday: 1970-01-01 was a Thursday.
fn weekday_index(days: i64) i64 {
    return floor_mod(days + 4, 7)
}

// The UTC date and time of an instant in nanoseconds.
fn utc(ns: i64) DateTime {
    var t = utc_s(floor_div(ns, SECOND))
    t.nano = floor_mod(ns, SECOND)
    return t
}

// The UTC date and time of a count of seconds since 1970-01-01, which
// reaches past the years an i64 of nanoseconds does.
fn utc_s(secs: i64) DateTime {
    const days = floor_div(secs, 86400)
    const rest = secs - days * 86400
    var t = civil(days)
    t.hour = rest / 3600
    t.minute = rest / 60 % 60
    t.second = rest % 60
    return t
}

// The date days after 1970-01-01, at midnight (Hinnant's civil_from_days).
fn civil(days: i64) DateTime {
    const z = days + 719468
    const era = floor_div(z, 146097)
    const doe = z - era * 146097
    const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    const doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    const mp = (5 * doy + 2) / 153
    const m = if (mp < 10) mp + 3 else mp - 9
    const y = yoe + era * 400 + (if (m <= 2) 1 else 0)
    return DateTime{ .year = y, .month = m, .day = doy - (153 * mp + 2) / 5 + 1, .hour = 0, .minute = 0, .second = 0, .nano = 0 }
}

// secs * SECOND + nano, nano in 0 to 999999999, or null if an i64 cannot
// hold it.
fn from_parts(secs: i64, nano: i64) ?i64 {
    // -9223372036854775808 is -9223372037 s + 145224192 ns.
    if (secs > 9223372036 or (secs == 9223372036 and nano > 854775807)) {
        return null
    }
    if (secs < -9223372037 or (secs == -9223372037 and nano < 145224192)) {
        return null
    }
    if (secs < 0) {
        // (secs + 1) first, so the smallest i64 is reached without passing it.
        return (secs + 1) * SECOND + (nano - SECOND)
    }
    return secs * SECOND + nano
}

// n in decimal, with zeros in front up to width digits.
fn append_padded(a: Allocator, inout out: Buf(u8), n: i64, width: i64) void {
    var buf: [20]u8 = @splat('0')
    var len = 0
    var v = n
    while (v > 0 or len == 0) {
        buf[len] = @as(u8, v % 10) + '0'
        v = v / 10
        len = len + 1
    }
    while (len < width) {
        buf[len] = '0'
        len = len + 1
    }
    while (len > 0) {
        len = len - 1
        a.push(&out, buf[len])
    }
}

// The instant ns as RFC 3339 at the end of out, in the time of a zone
// offset seconds east of UTC: "2026-11-16T09:30:00Z" for offset 0,
// "2026-11-16T17:30:00+08:00" for offset 8 * 3600. Fractions of a second
// are written only when there are any, without zeros at the end
// ("09:30:00.25Z"); seconds of the offset are dropped.
fn append_rfc3339(a: Allocator, inout out: Buf(u8), ns: i64, offset: i64) void {
    const off_min = offset / 60
    const t = utc_s(floor_div(ns, SECOND) + off_min * 60)
    append_padded(a, &out, t.year, 4)
    a.push(&out, '-')
    append_padded(a, &out, t.month, 2)
    a.push(&out, '-')
    append_padded(a, &out, t.day, 2)
    a.push(&out, 'T')
    append_padded(a, &out, t.hour, 2)
    a.push(&out, ':')
    append_padded(a, &out, t.minute, 2)
    a.push(&out, ':')
    append_padded(a, &out, t.second, 2)
    var nano = floor_mod(ns, SECOND)
    if (nano != 0) {
        var width = 9
        while (nano % 10 == 0) {
            nano = nano / 10
            width = width - 1
        }
        a.push(&out, '.')
        append_padded(a, &out, nano, width)
    }
    if (off_min == 0) {
        a.push(&out, 'Z')
        return
    }
    a.push(&out, if (off_min < 0) '-' else '+')
    const m = if (off_min < 0) 0 - off_min else off_min
    append_padded(a, &out, m / 60, 2)
    a.push(&out, ':')
    append_padded(a, &out, m % 60, 2)
}

// The instant ns as an HTTP date (RFC 9110's IMF-fixdate) at the end of
// out: "Sun, 06 Nov 1994 08:49:37 GMT".
fn append_http_date(a: Allocator, inout out: Buf(u8), ns: i64) void {
    const secs = floor_div(ns, SECOND)
    const t = utc_s(secs)
    const wd = weekday_index(floor_div(secs, 86400))
    a.append_str(&out, DAY_NAMES[wd * 3..wd * 3 + 3])
    a.append_str(&out, ", ")
    append_padded(a, &out, t.day, 2)
    a.push(&out, ' ')
    a.append_str(&out, MONTH_NAMES[t.month * 3 - 3..t.month * 3])
    a.push(&out, ' ')
    append_padded(a, &out, t.year, 4)
    a.push(&out, ' ')
    append_padded(a, &out, t.hour, 2)
    a.push(&out, ':')
    append_padded(a, &out, t.minute, 2)
    a.push(&out, ':')
    append_padded(a, &out, t.second, 2)
    a.append_str(&out, " GMT")
}

// The n digits of s at i as a number, or -1 if they are not all digits.
fn digits(s: []u8, i: i64, n: i64) i64 {
    if (i + n > @len(s)) {
        return -1
    }
    var v = 0
    for (s[i..i + n]) |c| {
        if (c < '0' or c > '9') {
            return -1
        }
        v = v * 10 + @as(i64, c - '0')
    }
    return v
}

fn byte_is(s: []u8, i: i64, c: u8) bool {
    return i < @len(s) and s[i] == c
}

// The instant an RFC 3339 date and time stands for, "2026-11-16T09:30:00Z"
// or with a fraction of a second and an offset from UTC
// ("2026-11-16T17:30:00.5+08:00"); null for anything else, a date that does
// not exist, or an instant past what an i64 of nanoseconds holds. Digits of
// the fraction past nanoseconds are dropped; t and z may be lower case.
fn parse_rfc3339(s: []u8) ?i64 {
    var t = DateTime{ .year = digits(s, 0, 4), .month = digits(s, 5, 2), .day = digits(s, 8, 2), .hour = digits(s, 11, 2), .minute = digits(s, 14, 2), .second = digits(s, 17, 2), .nano = 0 }
    if (t.year < 0 or !byte_is(s, 4, '-') or !byte_is(s, 7, '-') or !(byte_is(s, 10, 'T') or byte_is(s, 10, 't')) or !byte_is(s, 13, ':') or !byte_is(s, 16, ':')) {
        return null
    }
    var i = 19
    if (byte_is(s, i, '.')) {
        i = i + 1
        const start = i
        var scale = SECOND
        while (i < @len(s) and s[i] >= '0' and s[i] <= '9') {
            scale = scale / 10
            t.nano = t.nano + @as(i64, s[i] - '0') * scale
            i = i + 1
        }
        if (i == start) {
            return null
        }
    }
    if (!t.valid()) {
        return null
    }
    var offset = 0
    if (byte_is(s, i, 'Z') or byte_is(s, i, 'z')) {
        i = i + 1
    } else if (byte_is(s, i, '+') or byte_is(s, i, '-')) {
        const h = digits(s, i + 1, 2)
        const m = digits(s, i + 4, 2)
        if (h < 0 or h > 23 or !byte_is(s, i + 3, ':') or m < 0 or m > 59) {
            return null
        }
        offset = (h * 60 + m) * 60
        if (s[i] == '-') {
            offset = 0 - offset
        }
        i = i + 6
    } else {
        return null
    }
    if (i != @len(s)) {
        return null
    }
    return from_parts(t.unix() - offset, t.nano)
}

// 1 to 12 for the month's three letters at s[i], or -1.
fn month_at(s: []u8, i: i64) i64 {
    if (i + 3 > @len(s)) {
        return -1
    }
    var m = 0
    while (m < 12) {
        if (s[i..i + 3] == MONTH_NAMES[m * 3..m * 3 + 3]) {
            return m + 1
        }
        m = m + 1
    }
    return -1
}

// Where a weekday's name at the start of s ends: its three letters, or,
// with long, its whole name ("Sunday"); -1 if there is none.
fn weekday_end(s: []u8, long: bool) i64 {
    if (@len(s) < 3) {
        return -1
    }
    var d = 0
    while (d < 7) {
        if (s[0..3] == DAY_NAMES[d * 3..d * 3 + 3]) {
            if (!long) {
                return 3
            }
            // "Sun" + "day", "Mon" + "day", ..., "Wed" + "nesday".
            const rest = if (d == 2) "sday" else if (d == 3) "nesday" else if (d == 4) "rsday" else if (d == 6) "urday" else "day"
            const n = 3 + @len(rest)
            return if (@len(s) >= n and s[3..n] == rest) n else -1
        }
        d = d + 1
    }
    return -1
}

// "08:49:37" at s[i] into t, and whether it was there.
fn clock_at(s: []u8, i: i64, inout t: DateTime) bool {
    t.hour = digits(s, i, 2)
    t.minute = digits(s, i + 3, 2)
    t.second = digits(s, i + 6, 2)
    return t.hour >= 0 and t.minute >= 0 and t.second >= 0 and byte_is(s, i + 2, ':') and byte_is(s, i + 5, ':')
}

// The instant of an HTTP date, in any of the three forms RFC 9110 says a
// recipient must take: "Sun, 06 Nov 1994 08:49:37 GMT" (IMF-fixdate),
// "Sunday, 06-Nov-94 08:49:37 GMT" (RFC 850; years 69 to 99 are 1969 to
// 1999, 00 to 68 are 2000 to 2068) and "Sun Nov  6 08:49:37 1994" (C's
// asctime); null for anything else. The weekday's name must be one, but
// need not be the date's.
fn parse_http_date(s: []u8) ?i64 {
    var t = DateTime{ .year = -1, .month = -1, .day = -1, .hour = 0, .minute = 0, .second = 0, .nano = 0 }
    const short = weekday_end(s, false)
    if (short < 0) {
        return null
    }
    if (byte_is(s, 3, ',')) {
        // IMF-fixdate: "Sun, 06 Nov 1994 08:49:37 GMT"
        if (@len(s) != 29 or s[4] != ' ' or s[7] != ' ' or s[11] != ' ' or s[16] != ' ' or s[25..29] != " GMT" or !clock_at(s, 17, &t)) {
            return null
        }
        t.day = digits(s, 5, 2)
        t.month = month_at(s, 8)
        t.year = digits(s, 12, 4)
    } else if (byte_is(s, 3, ' ')) {
        // asctime: "Sun Nov  6 08:49:37 1994", the day padded with a space
        if (@len(s) != 24 or s[7] != ' ' or s[10] != ' ' or s[19] != ' ' or !clock_at(s, 11, &t)) {
            return null
        }
        t.month = month_at(s, 4)
        t.day = if (s[8] == ' ') digits(s, 9, 1) else digits(s, 8, 2)
        t.year = digits(s, 20, 4)
    } else {
        // RFC 850: "Sunday, 06-Nov-94 08:49:37 GMT"
        const n = weekday_end(s, true)
        if (n < 0 or @len(s) != n + 24) {
            return null
        }
        const d = s[n..]
        if (d[0..2] != ", " or d[4] != '-' or d[8] != '-' or d[11] != ' ' or d[20..24] != " GMT" or !clock_at(d, 12, &t)) {
            return null
        }
        t.day = digits(d, 2, 2)
        t.month = month_at(d, 5)
        const yy = digits(d, 9, 2)
        t.year = if (yy < 0) -1 else if (yy >= 69) 1900 + yy else 2000 + yy
    }
    if (t.year < 0 or !t.valid()) {
        return null
    }
    return from_parts(t.unix(), 0)
}

// One kind of local time in a zone: offset seconds east of UTC, whether it
// is daylight saving time, and its abbreviation ("EST"), abbr_len bytes at
// abbr in the zone's names.
const ZoneType = struct {
    offset: i64
    dst: bool
    abbr: i64
    abbr_len: i64
}

const DayKind = enum { julian, zero, month }

// When a POSIX TZ rule changes over: .julian is day 1 to 365, never
// counting February 29th ("J60" is always March 1st); .zero day 0 to 365;
// .month the week-th weekday day (0 Sunday) of month, week 5 being the
// last. time is seconds after midnight local time, which may be negative
// or past a day.
const RuleDay = struct {
    kind: DayKind
    month: i64
    week: i64
    day: i64
    time: i64
}

// A POSIX TZ rule ("EST5EDT,M3.2.0,M11.1.0"): standard time, and
// daylight saving time from start to end of each year if has_dst.
const Rule = struct {
    std: ZoneType
    dst: ZoneType
    has_dst: bool
    start: RuleDay
    end: RuleDay
}

// A time zone. Its changes of offset up to the last one listed are in
// times (seconds since 1970, ascending), each to the type types[kinds[i]];
// before the first, types[0] holds; after the last, the rule, when there
// is one. Zone.utc() has no types at all. It owns its buffers: free it
// with a.free.
const Zone = struct {
    names: Buf(u8)
    times: Buf(i64)
    kinds: Buf(u8)
    types: Buf(ZoneType)
    rule: ?Rule

    fn utc() Zone {
        return Zone{ .names = .empty, .times = .empty, .kinds = .empty, .types = .empty, .rule = null }
    }

    // The type in force at secs seconds since 1970.
    fn lookup(self: Zone, secs: i64) ZoneType {
        const n = @len(self.times)
        if (n == 0 or secs >= self.times[n - 1]) {
            if (self.rule) |r| {
                return rule_type(r, secs)
            }
        }
        if (@len(self.types) == 0) {
            return ZoneType{ .offset = 0, .dst = false, .abbr = 0, .abbr_len = 0 }
        }
        if (n == 0 or secs < self.times[0]) {
            return self.types[0]
        }
        // The last change at or before secs.
        var lo = 0
        var hi = n
        while (hi - lo > 1) {
            const mid = lo + (hi - lo) / 2
            if (self.times[mid] <= secs) {
                lo = mid
            } else {
                hi = mid
            }
        }
        return self.types[@as(i64, self.kinds[lo])]
    }

    // Seconds east of UTC at the instant ns.
    fn offset(self: Zone, ns: i64) i64 {
        return self.lookup(floor_div(ns, SECOND)).offset
    }

    fn dst(self: Zone, ns: i64) bool {
        return self.lookup(floor_div(ns, SECOND)).dst
    }

    // The abbreviation in use at the instant ns, such as "EST" or "+08";
    // "UTC" for Zone.utc().
    fn abbr(self: Zone, ns: i64) []u8 {
        if (@len(self.types) == 0 and self.rule == null) {
            return "UTC"
        }
        const t = self.lookup(floor_div(ns, SECOND))
        return self.names[t.abbr..t.abbr + t.abbr_len]
    }

    // The local date and time at the instant ns.
    fn at(self: Zone, ns: i64) DateTime {
        const secs = floor_div(ns, SECOND)
        var t = utc_s(secs + self.lookup(secs).offset)
        t.nano = floor_mod(ns, SECOND)
        return t
    }

    // The instant at which the local time is t; null if an i64 of
    // nanoseconds cannot hold it. When clocks go back, a time that happens
    // twice is the first of the two; when they go forward, a time that is
    // skipped is taken with the offset from before, so 02:30 on the day New
    // York skips to 03:00 is 03:30. Python's fold=0 does the same.
    fn instant(self: Zone, t: DateTime) ?i64 {
        if (!t.fits()) {
            return null
        }
        const wall = t.unix()
        const before = self.lookup(wall - 86400).offset
        const after = self.lookup(wall + 86400).offset
        // Either offset gives the time t when it is the one in force then;
        // in a gap neither is, and the one from before is taken.
        const u1 = wall - before
        const u2 = wall - after
        const ok1 = self.lookup(u1).offset == before
        const ok2 = self.lookup(u2).offset == after
        const u = if (ok2 and (!ok1 or u2 < u1)) u2 else u1
        return from_parts(u, floor_mod(t.nano, SECOND))
    }
}

// A zone always offset seconds east of UTC, called name.
fn fixed(a: Allocator, name: []u8, offset: i64) Zone {
    var types: Buf(ZoneType) = .empty
    a.push(&types, ZoneType{ .offset = offset, .dst = false, .abbr = 0, .abbr_len = @len(name) })
    return Zone{ .names = a.concat(name, ""), .times = .empty, .kinds = .empty, .types = types, .rule = null }
}

// The type a rule gives at secs seconds since 1970.
fn rule_type(r: Rule, secs: i64) ZoneType {
    if (!r.has_dst) {
        return r.std
    }
    // The year as standard time has it; the start is given in standard
    // time, the end in daylight saving time.
    const year = utc_s(secs + r.std.offset).year
    const start = rule_day(r.start, year) - r.std.offset
    const end = rule_day(r.end, year) - r.dst.offset
    // In the southern hemisphere the start comes after the end.
    const in_dst = if (start < end) secs >= start and secs < end else secs < end or secs >= start
    return if (in_dst) r.dst else r.std
}

// Local seconds since 1970 of a rule's day in a year, at its time.
fn rule_day(d: RuleDay, year: i64) i64 {
    var day = epoch_days(year, 1, 1)
    switch (d.kind) {
        .julian => {
            day = day + d.day - 1
            if (is_leap(year) and d.day >= 60) {
                day = day + 1
            }
        }
        .zero => {
            day = day + d.day
        }
        .month => {
            const first = epoch_days(year, d.month, 1)
            day = first + floor_mod(d.day - weekday_index(first), 7) + (d.week - 1) * 7
            const next = first + days_in_month(year, d.month)
            while (day >= next) {
                day = day - 7
            }
        }
    }
    return day * 86400 + d.time
}

// A POSIX TZ zone name at s[i]: letters ("EST"), or anything but '>'
// between '<' and '>' ("<+0530>"), at least 3 bytes either way. Its start
// and length, with i past it; null if there is none.
fn tz_name(s: []u8, inout i: i64) ?[2]i64 {
    if (byte_is(s, i, '<')) {
        var j = i + 1
        while (j < @len(s) and s[j] != '>') {
            j = j + 1
        }
        if (j == @len(s) or j - i - 1 < 3) {
            return null
        }
        const r = [2]i64{ i + 1, j - i - 1 }
        i = j + 1
        return r
    }
    var j = i
    while (j < @len(s) and ((s[j] >= 'a' and s[j] <= 'z') or (s[j] >= 'A' and s[j] <= 'Z'))) {
        j = j + 1
    }
    if (j - i < 3) {
        return null
    }
    const r = [2]i64{ i, j - i }
    i = j
    return r
}

// [+-]h[h][:mm[:ss]] at s[i] in seconds, hours up to max_hours, with i past
// it; null if there is none.
fn tz_hms(s: []u8, inout i: i64, max_hours: i64) ?i64 {
    var sign = 1
    if (byte_is(s, i, '+') or byte_is(s, i, '-')) {
        if (s[i] == '-') {
            sign = -1
        }
        i = i + 1
    }
    var h = 0
    var nd = 0
    while (nd < 3 and i < @len(s) and s[i] >= '0' and s[i] <= '9') {
        h = h * 10 + @as(i64, s[i] - '0')
        i = i + 1
        nd = nd + 1
    }
    if (nd == 0 or h > max_hours) {
        return null
    }
    var secs = h * 3600
    var unit = 60
    while (unit >= 1 and byte_is(s, i, ':')) {
        const v = digits(s, i + 1, 2)
        if (v < 0 or v > 59) {
            return null
        }
        secs = secs + v * unit
        i = i + 3
        unit = unit / 60
    }
    return sign * secs
}

// A number of up to 3 digits at s[i], with i past it, or -1.
fn tz_num(s: []u8, inout i: i64) i64 {
    var v = 0
    var nd = 0
    while (nd < 3 and i < @len(s) and s[i] >= '0' and s[i] <= '9') {
        v = v * 10 + @as(i64, s[i] - '0')
        i = i + 1
        nd = nd + 1
    }
    return if (nd == 0) -1 else v
}

// ",Jn[/time]", ",n[/time]" or ",Mm.w.d[/time]" at s[i]; the time is 02:00
// unless given, and may be -167 to 167 hours (RFC 8536).
fn tz_day(s: []u8, inout i: i64) ?RuleDay {
    if (!byte_is(s, i, ',')) {
        return null
    }
    i = i + 1
    var d = RuleDay{ .kind = .zero, .month = 0, .week = 0, .day = 0, .time = 7200 }
    if (byte_is(s, i, 'J')) {
        i = i + 1
        d.kind = .julian
        d.day = tz_num(s, &i)
        if (d.day < 1 or d.day > 365) {
            return null
        }
    } else if (byte_is(s, i, 'M')) {
        i = i + 1
        d.kind = .month
        d.month = tz_num(s, &i)
        if (!byte_is(s, i, '.')) {
            return null
        }
        i = i + 1
        d.week = tz_num(s, &i)
        if (!byte_is(s, i, '.')) {
            return null
        }
        i = i + 1
        d.day = tz_num(s, &i)
        if (d.month < 1 or d.month > 12 or d.week < 1 or d.week > 5 or d.day < 0 or d.day > 6) {
            return null
        }
    } else {
        d.day = tz_num(s, &i)
        if (d.day < 0 or d.day > 365) {
            return null
        }
    }
    if (byte_is(s, i, '/')) {
        i = i + 1
        d.time = tz_hms(s, &i, 167) orelse return null
    }
    return d
}

// A POSIX TZ rule, its abbreviations appended to names; null if s is not
// one. Daylight saving time without a rule for when is the United States'
// since 2007, as in Go.
fn tz_rule(a: Allocator, inout names: Buf(u8), s: []u8) ?Rule {
    var i = 0
    const std_name = tz_name(s, &i) orelse return null
    // POSIX counts hours west of UTC.
    const std_off = 0 - (tz_hms(s, &i, 24) orelse return null)
    var r = Rule{ .std = ZoneType{ .offset = std_off, .dst = false, .abbr = @len(names), .abbr_len = std_name[1] }, .dst = ZoneType{ .offset = std_off, .dst = false, .abbr = 0, .abbr_len = 0 }, .has_dst = false, .start = RuleDay{ .kind = .month, .month = 3, .week = 2, .day = 0, .time = 7200 }, .end = RuleDay{ .kind = .month, .month = 11, .week = 1, .day = 0, .time = 7200 } }
    a.append_str(&names, s[std_name[0]..std_name[0] + std_name[1]])
    if (i == @len(s)) {
        return r
    }
    const dst_name = tz_name(s, &i) orelse return null
    var dst_off = std_off + 3600
    if (i < @len(s) and s[i] != ',') {
        dst_off = 0 - (tz_hms(s, &i, 24) orelse return null)
    }
    r.has_dst = true
    r.dst = ZoneType{ .offset = dst_off, .dst = true, .abbr = @len(names), .abbr_len = dst_name[1] }
    a.append_str(&names, s[dst_name[0]..dst_name[0] + dst_name[1]])
    if (i < @len(s)) {
        r.start = tz_day(s, &i) orelse return null
        r.end = tz_day(s, &i) orelse return null
    }
    return if (i == @len(s)) r else null
}

// A zone of a POSIX TZ rule alone, such as "CST-8" or
// "EST5EDT,M3.2.0,M11.1.0"; error.BadZone if s is not one.
fn posix_zone(a: Allocator, s: []u8) !Zone {
    var names: Buf(u8) = .empty
    const r = tz_rule(a, &names, s) orelse {
        a.free(names)
        return error.BadZone
    }
    return Zone{ .names = names, .times = .empty, .kinds = .empty, .types = .empty, .rule = r }
}

// The big-endian n-byte integer at data[i], signed if n is 4 or 8.
fn be(data: []u8, i: i64, n: i64) i64 {
    var v = 0
    for (data[i..i + n]) |c| {
        v = (v << 8) | @as(i64, c)
    }
    if (n == 4 and v >= 0x80000000) {
        v = v - 0x100000000
    }
    return v
}

// A zone from the bytes of a TZif file (RFC 8536, versions 1 to 4), as
// /usr/share/zoneinfo holds them; error.BadZone if data is not one. Leap
// seconds in it are ignored, as everywhere in std/time.
fn parse_tzif(a: Allocator, data: []u8) !Zone {
    if (@len(data) < 44 or data[0..4] != "TZif") {
        return error.BadZone
    }
    var p = 0
    var tsize = 4
    if (data[4] >= '2') {
        // Past the version 1 block, to the second header and its 8-byte
        // times.
        p = 44 + be(data, 32, 4) * 5 + be(data, 36, 4) * 6 + be(data, 40, 4) + be(data, 28, 4) * 8 + be(data, 24, 4) + be(data, 20, 4)
        if (p < 44 or p + 44 > @len(data) or data[p..p + 4] != "TZif") {
            return error.BadZone
        }
        tsize = 8
    }
    const isutcnt = be(data, p + 20, 4)
    const isstdcnt = be(data, p + 24, 4)
    const leapcnt = be(data, p + 28, 4)
    const timecnt = be(data, p + 32, 4)
    const typecnt = be(data, p + 36, 4)
    const charcnt = be(data, p + 40, 4)
    if (isutcnt < 0 or isstdcnt < 0 or leapcnt < 0 or timecnt < 0 or typecnt < 1 or charcnt < 1) {
        return error.BadZone
    }
    const tp = p + 44
    const kp = tp + timecnt * tsize
    const yp = kp + timecnt
    const cp = yp + typecnt * 6
    const end = cp + charcnt + leapcnt * (tsize + 4) + isstdcnt + isutcnt
    if (end > @len(data)) {
        return error.BadZone
    }
    var z = Zone.utc()
    errdefer a.free(z)
    a.append_str(&z.names, data[cp..cp + charcnt])
    var i = 0
    while (i < typecnt) {
        const q = yp + i * 6
        const idx = @as(i64, data[q + 5])
        if (idx >= charcnt or data[q + 4] > 1) {
            return error.BadZone
        }
        var n = 0
        while (idx + n < charcnt and data[cp + idx + n] != 0) {
            n = n + 1
        }
        a.push(&z.types, ZoneType{ .offset = be(data, q, 4), .dst = data[q + 4] == 1, .abbr = idx, .abbr_len = n })
        i = i + 1
    }
    i = 0
    while (i < timecnt) {
        const t = be(data, tp + i * tsize, tsize)
        const k = data[kp + i]
        if (@as(i64, k) >= typecnt or (i > 0 and t <= z.times[i - 1])) {
            return error.BadZone
        }
        a.push(&z.times, t)
        a.push(&z.kinds, k)
        i = i + 1
    }
    // The footer: a POSIX TZ rule between newlines, for times after the
    // last change, maybe empty.
    if (tsize == 8 and end < @len(data)) {
        if (data[end] != '\n' or data[@len(data) - 1] != '\n' or @len(data) - end < 2) {
            return error.BadZone
        }
        const footer = data[end + 1..@len(data) - 1]
        if (@len(footer) > 0) {
            z.rule = tz_rule(a, &z.names, footer) orelse return error.BadZone
        }
    }
    return z
}

// Where load looks, in order, as Go does.
fn zone_dir(i: i64) str {
    if (i == 0) {
        return "/usr/share/zoneinfo/"
    }
    if (i == 1) {
        return "/usr/share/lib/zoneinfo/"
    }
    if (i == 2) {
        return "/usr/lib/locale/TZ/"
    }
    return "/etc/zoneinfo/"
}

// The zone called name in the system's database ("Asia/Shanghai"), or
// Zone.utc() for "UTC"; error.UnknownZone if no file has it (Windows has
// none) or the name could leave the database ("../x", "/etc/x"), and
// error.BadZone if the file is not TZif.
fn load(fs: Fs, a: Allocator, name: []u8) !Zone {
    if (name == "UTC") {
        return Zone.utc()
    }
    if (@len(name) == 0 or name[0] == '/' or name[0] == '\\' or contains_dotdot(name)) {
        return error.UnknownZone
    }
    var d = 0
    while (d < 4) {
        const path = a.concat(zone_dir(d), name)
        defer a.free(path)
        const data = fs.read(a, path) catch {
            d = d + 1
            continue
        }
        defer a.free(data)
        return parse_tzif(a, data)
    }
    return error.UnknownZone
}

fn contains_dotdot(s: []u8) bool {
    var i = 0
    while (i + 1 < @len(s)) {
        if (s[i] == '.' and s[i + 1] == '.') {
            return true
        }
        i = i + 1
    }
    return false
}

// The local time zone, as the C library finds it: the TZ environment
// variable if set ("" is UTC; ":Europe/Paris", "Europe/Paris" or
// "/path/to/file" a file of the database; otherwise a POSIX rule such as
// "CST-8"), else /etc/localtime. Anything it cannot read is UTC, as in Go,
// so on Windows the local zone is UTC unless TZ holds a POSIX rule.
fn local(fs: Fs, env: Args, a: Allocator) Zone {
    const tz = env.env("TZ") orelse {
        return file_zone(fs, a, "/etc/localtime")
    }
    const name = without_colon(tz)
    if (@len(name) == 0) {
        return Zone.utc()
    }
    if (name[0] == '/') {
        return file_zone(fs, a, name)
    }
    return load(fs, a, name) catch {
        return posix_zone(a, name) catch Zone.utc()
    }
}

fn without_colon(s: []u8) []u8 {
    return if (@len(s) > 0 and s[0] == ':') s[1..] else s
}

// The zone in a TZif file, or UTC.
fn file_zone(fs: Fs, a: Allocator, path: []u8) Zone {
    const data = fs.read(a, path) catch {
        return Zone.utc()
    }
    defer a.free(data)
    return parse_tzif(a, data) catch Zone.utc()
}
