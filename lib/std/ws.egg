// std/ws: WebSocket (RFC 6455) for servers: the handshake, frames out, and
// messages in. A server's frames go out unmasked and whole; a client's come
// in masked, and a message may come in fragments, with control frames
// between them. No extension is offered (no permessage-deflate).
// const ws = @import("std/ws")
// if (ws.is_handshake(a, req)) { try c.write(ws.handshake(a, key, "")) ... }
// then take messages from the bytes that come (take), or read them (read_message).
uses alloc, net

const codec = @import("std/codec")
const sha1 = @import("std/sha1")
const http = @import("std/http")

const GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

const CONTINUATION = 0
const TEXT = 1
const BINARY = 2
const CLOSE = 8
const PING = 9
const PONG = 10

// What take and read_message give for a frame no client may send (close
// 1002), and for a message larger than MAX_MESSAGE (close 1009); -kind is
// the close code.
const PROTOCOL_ERROR = -1002
const TOO_BIG = -1009
const MAX_MESSAGE = 1048576

// Is key a Sec-WebSocket-Key: the Base64 of 16 bytes?
fn valid_key(a: Allocator, key: []u8) bool {
    var raw: Buf(u8) = .empty
    defer a.free(raw)
    return codec.base64_decode(a, &raw, key) and @len(raw) == 16
}

// Sec-WebSocket-Accept for key.
fn accept(a: Allocator, key: []u8) Buf(u8) {
    const joined = a.concat(key, GUID)
    defer a.free(joined)
    const digest = sha1.sum(a, joined)
    defer a.free(digest)
    var out: Buf(u8) = .empty
    codec.base64_encode(a, &out, digest)
    return out
}

// A whole frame of opcode with payload, at the end of out.
fn frame(a: Allocator, inout out: Buf(u8), opcode: i64, payload: []u8) void {
    a.push(&out, @as(u8, 0x80 | opcode))
    const n = @len(payload)
    if (n < 126) {
        a.push(&out, @as(u8, n))
    } else if (n < 65536) {
        a.push(&out, 126)
        a.push(&out, @as(u8, n >> 8))
        a.push(&out, @as(u8, n & 0xFF))
    } else {
        a.push(&out, 127)
        var shift = 56
        while (shift >= 0) {
            a.push(&out, @as(u8, (n >> shift) & 0xFF))
            shift = shift - 8
        }
    }
    a.append_str(&out, payload)
}

// A text frame of payload, by itself.
fn text_frame(a: Allocator, payload: []u8) Buf(u8) {
    var out: Buf(u8) = .empty
    frame(a, &out, TEXT, payload)
    return out
}

// A close frame with code and no reason.
fn close_frame(a: Allocator, code: i64) Buf(u8) {
    var body: Buf(u8) = .empty
    defer a.free(body)
    a.push(&body, @as(u8, code >> 8))
    a.push(&body, @as(u8, code & 0xFF))
    var out: Buf(u8) = .empty
    frame(a, &out, CLOSE, body)
    return out
}

// What a connection has received of a message that came in fragments.
const Partial = owned struct {
    // Its opcode (text or binary), or -1 between messages.
    kind: i64
    data: Buf(u8)

    fn deinit(sink self: Partial, a: Allocator) void {
        a.free(self.data)
        @forget(self)
    }
}

fn partial() Partial {
    return Partial{ .kind = -1, .data = .empty }
}

// What take gives when inbox does not hold a whole frame yet.
const NEED_MORE = -1

// The next message from the bytes received so far (inbox, from which it
// takes what it reads), in data in place of what it held: a text or binary
// message whole, or a control frame (CLOSE, PING, PONG) with its payload,
// which may come between the fragments of a message (kept in part
// meanwhile). Its opcode, NEED_MORE until a whole frame has come, or
// PROTOCOL_ERROR or TOO_BIG.
fn take(a: Allocator, inout inbox: Buf(u8), inout part: Partial, inout data: Buf(u8)) i64 {
    a.free(@replace(&data, .empty))
    while (true) {
        const n_in = @len(inbox)
        if (n_in < 2) {
            return NEED_MORE
        }
        const fin = (inbox[0] & 0x80) != 0
        const opcode = @as(i64, inbox[0] & 0x0F)
        var n = @as(i64, inbox[1] & 0x7F)
        if ((inbox[0] & 0x70) != 0 or (inbox[1] & 0x80) == 0) {
            return PROTOCOL_ERROR
        }
        var at = 2
        if (n == 126) {
            if (n_in < 4) {
                return NEED_MORE
            }
            n = @as(i64, inbox[2]) << 8 | @as(i64, inbox[3])
            at = 4
        } else if (n == 127) {
            if (n_in < 10) {
                return NEED_MORE
            }
            if ((inbox[2] & 0x80) != 0) {
                return PROTOCOL_ERROR
            }
            n = 0
            var i = 2
            while (i < 10) {
                n = n << 8 | @as(i64, inbox[i])
                i = i + 1
            }
            at = 10
        }
        const control = opcode >= CLOSE
        if (opcode >= 3 and opcode <= 7 or opcode > PONG) {
            return PROTOCOL_ERROR
        }
        if (control and (!fin or n > 125)) {
            return PROTOCOL_ERROR
        }
        if (!control and (opcode == CONTINUATION) == (part.kind < 0)) {
            return PROTOCOL_ERROR
        }
        if (!control and @len(part.data) + n > MAX_MESSAGE) {
            return TOO_BIG
        }
        if (n_in < at + 4 + n) {
            return NEED_MORE
        }
        const mask = at
        const from = at + 4
        var i = 0
        while (i < n) {
            const b = inbox[from + i] ^ inbox[mask + i % 4]
            if (control) {
                a.push(&data, b)
            } else {
                a.push(&part.data, b)
            }
            i = i + 1
        }
        // What is left of the bytes, without this frame.
        const rest = a.concat(inbox[from + n..], "")
        a.free(@replace(&inbox, rest))
        if (control) {
            return opcode
        }
        if (part.kind < 0) {
            part.kind = opcode
        }
        if (fin) {
            const kind = part.kind
            part.kind = -1
            a.free(@replace(&data, @replace(&part.data, .empty)))
            return kind
        }
    }
    return NEED_MORE
}

// Is req a WebSocket handshake this module can answer: a GET with
// Connection: upgrade, Upgrade: websocket, Sec-WebSocket-Version: 13 and a
// valid Sec-WebSocket-Key? Which origins and protocols to allow is the
// caller's to decide.
fn is_handshake(a: Allocator, req: http.Request) bool {
    if (!req.upgrade or req.method != "GET") {
        return false
    }
    const version = http.header(req, "Sec-WebSocket-Version") orelse ""
    const key = http.header(req, "Sec-WebSocket-Key") orelse ""
    return version == "13" and valid_key(a, key)
}

// The 101 Switching Protocols response to a handshake with key (its
// Sec-WebSocket-Key), naming protocol if it is not empty: one of those the
// client offered in Sec-WebSocket-Protocol.
fn handshake(a: Allocator, key: []u8, protocol: []u8) Buf(u8) {
    var out: Buf(u8) = .empty
    a.append_str(&out, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ")
    const accepted = accept(a, key)
    defer a.free(accepted)
    a.append_str(&out, accepted)
    a.append_str(&out, "\r\n")
    if (@len(protocol) > 0) {
        a.append_str(&out, "Sec-WebSocket-Protocol: ")
        a.append_str(&out, protocol)
        a.append_str(&out, "\r\n")
    }
    a.append_str(&out, "\r\n")
    return out
}

// The next message from c, as take gives it, reading into inbox as long as
// it takes (keep inbox for the life of the connection, with what http's
// read_request left in it). A timeout only means the client is quiet:
// waiting goes on. Fails with error.Closed if c ends first.
fn read_message(c: TcpConn, a: Allocator, inout inbox: Buf(u8), inout part: Partial, inout data: Buf(u8)) !i64 {
    var chunk: Buf(u8) = .empty
    defer a.free(chunk)
    while (true) {
        const kind = take(a, &inbox, &part, &data)
        if (kind != NEED_MORE) {
            return kind
        }
        const n = c.read(a, &chunk, 65536) catch |e| {
            if (e == error.TimedOut) {
                continue
            }
            return e
        }
        if (n == 0) {
            return error.Closed
        }
        a.append_str(&inbox, chunk)
    }
    return NEED_MORE
}
