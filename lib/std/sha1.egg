// std/sha1: SHA-1 (RFC 3174), for protocols that name it, such as the
// WebSocket handshake. It is broken for signatures: do not use it where an
// attacker chooses the input and a collision matters.
// const sha1 = @import("std/sha1")
// sha1.sum(a, "abc") is the 20 bytes a9993e36...; free it with a.free.
uses alloc

fn rotl(x: u32, n: i64) u32 {
    return (x << n) | (x >> (32 - n))
}

// The sum of words modulo 2^32: u32 addition would panic on the carry.
fn add(x: u32, y: u32) u32 {
    return @as(u32, (@as(u64, x) + @as(u64, y)) & 0xFFFF_FFFF)
}

fn add5(p: u32, q: u32, r: u32, s: u32, t: u32) u32 {
    return @as(u32, (@as(u64, p) + @as(u64, q) + @as(u64, r) + @as(u64, s) + @as(u64, t)) & 0xFFFF_FFFF)
}

// The 20-byte digest of data.
fn sum(a: Allocator, data: []u8) Buf(u8) {
    // The message, a 1 bit, zeros to 56 bytes past a multiple of 64, and
    // its length in bits as 8 big-endian bytes.
    var msg = a.concat(data, "")
    defer a.free(msg)
    a.push(&msg, 0x80)
    while (@len(msg) % 64 != 56) {
        a.push(&msg, 0)
    }
    const bits = @as(u64, @len(data)) << 3
    var shift = 56
    while (shift >= 0) {
        a.push(&msg, @as(u8, (bits >> shift) & 0xFF))
        shift = shift - 8
    }
    var h0: u32 = 0x67452301
    var h1: u32 = 0xEFCDAB89
    var h2: u32 = 0x98BADCFE
    var h3: u32 = 0x10325476
    var h4: u32 = 0xC3D2E1F0
    var w: [80]u32 = @splat(0)
    var block = 0
    while (block < @len(msg)) {
        var i = 0
        while (i < 16) {
            const at = block + i * 4
            w[i] = @as(u32, msg[at]) << 24 | @as(u32, msg[at + 1]) << 16 | @as(u32, msg[at + 2]) << 8 | @as(u32, msg[at + 3])
            i = i + 1
        }
        while (i < 80) {
            w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
            i = i + 1
        }
        var x0 = h0
        var x1 = h1
        var x2 = h2
        var x3 = h3
        var x4 = h4
        i = 0
        while (i < 80) {
            var f: u32 = 0
            var k: u32 = 0
            if (i < 20) {
                f = (x1 & x2) | (~x1 & x3)
                k = 0x5A827999
            } else if (i < 40) {
                f = x1 ^ x2 ^ x3
                k = 0x6ED9EBA1
            } else if (i < 60) {
                f = (x1 & x2) | (x1 & x3) | (x2 & x3)
                k = 0x8F1BBCDC
            } else {
                f = x1 ^ x2 ^ x3
                k = 0xCA62C1D6
            }
            const t = add5(rotl(x0, 5), f, x4, k, w[i])
            x4 = x3
            x3 = x2
            x2 = rotl(x1, 30)
            x1 = x0
            x0 = t
            i = i + 1
        }
        h0 = add(h0, x0)
        h1 = add(h1, x1)
        h2 = add(h2, x2)
        h3 = add(h3, x3)
        h4 = add(h4, x4)
        block = block + 64
    }
    var out: Buf(u8) = .empty
    for ([_]u32{ h0, h1, h2, h3, h4 }) |h| {
        a.push(&out, @as(u8, h >> 24))
        a.push(&out, @as(u8, (h >> 16) & 0xFF))
        a.push(&out, @as(u8, (h >> 8) & 0xFF))
        a.push(&out, @as(u8, h & 0xFF))
    }
    return out
}
