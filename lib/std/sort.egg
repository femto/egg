// std/sort: in-place algorithms on a mutable slice.
// const sort = @import("std/sort")
// sort.sort(i64, &b[0..]) sorts b ascending, by < (numbers or text);
// sort.sort_by(Row, &rows[0..], by_count) by any order: less(x, y) is
// true when x goes before y. Elements may own buffers: sort.sort_by(Row,
// &rows[0..], by_word) with a Row that holds a Buf(u8).

// Heapsort: O(n log n), allocates nothing. Not stable.
fn sort(comptime T: type, inout xs: []T) void {
    const n = @len(xs)
    var i = n / 2 - 1
    while (i >= 0) {
        sift(T, &xs[0..], i, n)
        i = i - 1
    }
    var end = n - 1
    while (end > 0) {
        @swap(&xs, 0, end)
        sift(T, &xs[0..], 0, end)
        end = end - 1
    }
}

// Moves xs[root] down until xs[0..end] is a max-heap below it again.
fn sift(comptime T: type, inout xs: []T, root: i64, end: i64) void {
    var r = root
    while (2 * r + 1 < end) {
        var child = 2 * r + 1
        if (child + 1 < end and xs[child] < xs[child + 1]) {
            child = child + 1
        }
        if (!(xs[r] < xs[child])) {
            return
        }
        @swap(&xs, r, child)
        r = child
    }
}

// Heapsort by less: O(n log n), allocates nothing. Not stable; to break
// ties, compare more fields in less.
fn sort_by(comptime T: type, inout xs: []T, less: fn(T, T) bool) void {
    const n = @len(xs)
    var i = n / 2 - 1
    while (i >= 0) {
        sift_by(T, &xs[0..], i, n, less)
        i = i - 1
    }
    var end = n - 1
    while (end > 0) {
        @swap(&xs, 0, end)
        sift_by(T, &xs[0..], 0, end, less)
        end = end - 1
    }
}

fn sift_by(comptime T: type, inout xs: []T, root: i64, end: i64, less: fn(T, T) bool) void {
    var r = root
    while (2 * r + 1 < end) {
        var child = 2 * r + 1
        if (child + 1 < end and less(xs[child], xs[child + 1])) {
            child = child + 1
        }
        if (!less(xs[r], xs[child])) {
            return
        }
        @swap(&xs, r, child)
        r = child
    }
}

fn reverse(comptime T: type, inout xs: []T) void {
    var i = 0
    var j = @len(xs) - 1
    while (i < j) {
        @swap(&xs, i, j)
        i = i + 1
        j = j - 1
    }
}

fn is_sorted(comptime T: type, xs: []T) bool {
    var i = 1
    while (i < @len(xs)) {
        if (xs[i] < xs[i - 1]) {
            return false
        }
        i = i + 1
    }
    return true
}
