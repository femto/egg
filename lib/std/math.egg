// std/math: small numeric helpers for any number type.
// const math = @import("std/math")

fn min(comptime T: type, a: T, b: T) T {
    if (a < b) {
        return a
    }
    return b
}

fn max(comptime T: type, a: T, b: T) T {
    if (a > b) {
        return a
    }
    return b
}

// An unsigned x is its own absolute value; otherwise 0 - x, not -x, so
// abs(f64, -0.0) is 0.0.
fn abs(comptime T: type, x: T) T {
    if (T == u8 or T == u16 or T == u32 or T == u64 or T == usize) {
        return x
    } else {
        if (x <= 0) {
            return 0 - x
        }
        return x
    }
}

// a clamped into [lo, hi]
fn clamp(comptime T: type, x: T, lo: T, hi: T) T {
    return min(T, max(T, x, lo), hi)
}
