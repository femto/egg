(* Egg v2 core grammar.
   Machine-readable source of truth for the parser in lib/egg/parser.rb.
   NL is a newline token. Statements end at NL or before '}'.
   Inside an expression a newline may appear only where `nl` is written:
   after a binary operator, after '(' '[' '{' and ',', and before ')' ']'
   '}'; a statement may also continue onto 'else'. *)

nl          = { NL } ;

program     = { NL } , { ( func | extern_fn | type_decl | type_alias | import | uses | allow | link ) , { NL } } , EOF ;
uses        = "uses" , IDENT , { "," , IDENT } , NL ;          (* capabilities: alloc args fs io *)
allow       = "allow" , IDENT , NL ;                           (* only: allow unsafe *)
link        = "link" , STRING , NL ;                           (* C library; needs allow unsafe *)
extern_fn   = "extern" , "fn" , IDENT , params , type ,
              [ "uses" , IDENT , { "," , IDENT } ] , NL ;      (* needs allow unsafe *)
import      = "const" , IDENT , "=" , "@import" , "(" , STRING , ")" , NL ;
                                                     (* "path.egg": a file under the module's root;
                                                        "std/name": a module of the standard library *)

func        = "fn" , IDENT , params , type , block ;
params      = "(" , [ param , { "," , param } , [ "," ] ] , ")" ;
param       = [ "inout" | "sink" | "comptime" ] , IDENT , ":" , type ;

type        = name                                   (* i8..i64 u8..u64 usize f32 f64 bool str void type anyerror Io Allocator Fs Args, or a declared type *)
            | name , "(" , nl , [ type , nl , { "," , nl , type , nl } , [ "," , nl ] ] , ")"
                                                     (* type function instance: Pair(i64), Unit(); also Buf(T) *)
            | "[" , nl , INT , "]" , type            (* array *)
            | "[" , nl , "]" , type                  (* slice: parameters, arguments, for subjects *)
            | "!" , type                             (* error union *)
            | "?" , type                             (* optional *)
            | "*" , type                             (* pointer *)
            | fn_type
            | "@This" , "(" , ")" ;
name        = IDENT , [ "." , IDENT ] ;              (* m.Point: a type of an imported module *)
fn_type     = "fn" , "(" , nl , [ type , nl , { "," , nl , type , nl } , [ "," , nl ] ] , ")" , type ;

type_decl   = "const" , IDENT , "=" , ( struct_body_kw | enum_body | union_body ) ;
type_alias  = "const" , IDENT , "=" , type , NL ;
struct_body_kw = [ "owned" ] , "struct" , struct_body ;
struct_body = "{" , { NL } , { ( field | func ) , [ "," ] , { NL } } , "}" ;
field       = IDENT , ":" , type ;
enum_body   = "enum" , "{" , { NL } , IDENT , { [ "," ] , { NL } , IDENT } , [ "," ] , { NL } , "}" ;
union_body  = "union" , "(" , "enum" , ")" , "{" , { NL } ,
              { func , [ "," ] , { NL } } ,          (* at least one member *)
              IDENT , [ ":" , type ] , [ "," ] , { NL } ,
              { ( IDENT , [ ":" , type ] | func ) , [ "," ] , { NL } } , "}" ;

block       = "{" , { NL } , { stmt , ( NL | (* before *) "}" ) , { NL } } , "}" ;

stmt        = var_decl | assign | if_stmt | while_stmt | for_stmt | switch_stmt
            | "break" | "continue" | return_stmt | defer_stmt | expr ;
                                                     (* an expr statement does not start with "if":
                                                        a leading if is always if_stmt *)
defer_stmt  = ( "defer" | "errdefer" ) , expr ;          (* a void expression without try *)
var_decl    = ( "var" | "const" ) , IDENT , [ ":" , type ] , "=" , expr ;
assign      = place , "=" , expr ;                 (* "_" = expr drops the value *)
place       = IDENT , { "." , IDENT | "[" , expr , "]" | "." , "*" }
            | postfix , "." , "*" , { "." , IDENT | "[" , expr , "]" | "." , "*" } ;
                                                     (* behind a pointer: @ptrAdd(p, 1).* = v *)
if_stmt     = "if" , "(" , expr , ")" , block , [ nl , "else" , ( if_stmt | block ) ] ;
while_stmt  = "while" , "(" , expr , ")" , block ;
for_stmt    = "for" , "(" , expr , ")" , "|" , IDENT , [ "," , IDENT ] , "|" , block ;
switch_stmt = "switch" , "(" , expr , ")" , "{" , { NL } , { arm , [ "," ] , { NL } } , "}" ;
arm         = ( member , { "," , member } | "else" ) , "=>" ,
              [ "|" , IDENT , "|" ] , block ;
member      = "." , IDENT | "error" , "." , IDENT ;   (* error.Name: in a switch on an anyerror *)
return_stmt = "return" , [ expr ] ;

expr        = or_expr , { "catch" , nl , [ "|" , IDENT , "|" , nl ] , fallback | "orelse" , nl , fallback } ;
fallback    = or_expr | "return" , [ or_expr ] | "break" | "continue" | block ;
or_expr     = and_expr , { "or" , nl , and_expr } ;
and_expr    = cmp_expr , { "and" , nl , cmp_expr } ;
cmp_expr    = bit_expr , [ cmp_op , nl , bit_expr ] ;   (* not chainable: a < b < c is E002 *)
cmp_op      = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
bit_expr    = shift_expr , { bit_op , nl , shift_expr } ;   (* the parser allows one bit_op per bit_expr: a | b & c is E002 *)
bit_op      = "&" | "|" | "^" ;
shift_expr  = add_expr , { ( "<<" | ">>" ) , nl , add_expr } ;
add_expr    = mul_expr , { ( "+" | "-" ) , nl , mul_expr } ;
mul_expr    = unary , { ( "*" | "/" | "%" ) , nl , unary } ;
unary       = ( "-" | "!" | "~" | "try" | "&" ) , unary | postfix ;
postfix     = primary , { "." , IDENT , [ args ]            (* field, method call *)
                        | "." , "*"                         (* p.*: what p points to *)
                        | "[" , nl , expr , nl , "]"        (* index *)
                        | "[" , nl , expr , nl , ".." , nl , [ expr , nl ] , "]"    (* slice *)
                        | struct_lit } ;                    (* after a capitalised type: Point, m.Point, Pair(i64) *)
struct_lit  = "{" , { NL } , { "." , IDENT , "=" , expr , [ "," ] , { NL } } , "}" ;
primary     = INT | FLOAT | STRING | CHAR | "true" | "false" | "null"
            | "*" , type | fn_type                  (* a type as a value: @ptrCast( *u8, p) *)
            | IDENT , [ args ]                      (* variable, call, type name *)
            | BUILTIN , args                        (* @len(...) ... *)
            | "@This" , "(" , ")"
            | "." , IDENT                           (* enum member, typed by context *)
            | "error" , "." , IDENT
            | "[" , nl , ( INT | "_" ) , "]" , type ,
              "{" , nl , [ expr , nl , { "," , nl , expr , nl } , [ "," , nl ] ] , "}"
            | "[" , nl , "]" , type                 (* a slice type as a value *)
            | "struct" , struct_body                (* only as a type function's result *)
            | "if" , "(" , nl , expr , nl , ")" , nl , expr , nl , "else" , nl , expr
                                                    (* a value; not at the start of a statement *)
            | "(" , nl , expr , nl , ")" ;
args        = "(" , nl , [ expr , nl , { "," , nl , expr , nl } , [ "," , nl ] ] , ")" ;

(* Lexical *)
IDENT       = letter_ , { letter_ | digit } ;      (* not a keyword *)
INT         = decimal                              (* at most u64's maximum; must fit its type *)
            | "0x" , hex , { hex | "_" }
            | "0b" , ( "0" | "1" ) , { "0" | "1" | "_" } ;
decimal     = digit , { digit | "_" } ;
FLOAT       = decimal , ( "." , decimal , [ exponent ] | exponent ) ;  (* f64, or f32 from context *)
exponent    = ( "e" | "E" ) , [ "+" | "-" ] , decimal ;
STRING      = '"' , { char | escape | "\x" , hex , hex | "\u{" , hex , [ hex , [ hex , [ hex , [ hex , [ hex ] ] ] ] ] , "}" } , '"' ;
                                                   (* one line; escapes \n \r \t \\ \" \0; \xNN is any byte,
                                                      \u{N} a code point (not a surrogate, at most 10FFFF)
                                                      written as its UTF-8 bytes *)
CHAR        = "'" , ( byte | escape | "\x" , hex , hex ) , "'" ;  (* an INT: 'a' is 97; byte: one ASCII character
                                                       but ' \ and newline, so 'é' (two UTF-8 bytes) is E001;
                                                       escapes \n \r \t \\ \' \" \0 *)
BUILTIN     = "@" , IDENT ;
COMMENT     = "//" , { any char except newline } ;
KEYWORDS    = fn return if else while for break continue switch var const
              true false and or struct enum union try catch orelse error inout sink comptime uses
              allow extern link owned null defer errdefer ;
