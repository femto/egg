(* Egg v1 core grammar.
   Machine-readable source of truth for the parser in lib/egg/parser.rb.
   NL is a newline token. Statements end at NL or before '}'.
   A newline may appear after a binary operator, after '(' '[' '{' and ',',
   and before 'else'; nowhere else inside an expression. *)

program     = { NL } , { ( func | type_decl ) , { NL } } , EOF ;

func        = "fn" , IDENT , params , type , block ;
params      = "(" , [ param , { "," , param } , [ "," ] ] , ")" ;
param       = [ "inout" | "comptime" ] , IDENT , ":" , type ;

type        = IDENT                                  (* i64 bool str void type, or a declared type *)
            | IDENT , "(" , type , { "," , type } , ")"   (* type function instance: Pair(i64) *)
            | "[" , INT , "]" , type                 (* array *)
            | "[" , "]" , type                       (* slice: parameters only *)
            | "!" , type                             (* error union *)
            | "@This" , "(" , ")" ;

type_decl   = "const" , IDENT , "=" , ( struct_body_kw | enum_body | union_body ) ;
struct_body_kw = "struct" , struct_body ;
struct_body = "{" , { NL } , { ( field | func ) , [ "," ] , { NL } } , "}" ;
field       = IDENT , ":" , type ;
enum_body   = "enum" , "{" , { NL } , IDENT , { [ "," ] , { NL } , IDENT } , [ "," ] , { NL } , "}" ;
union_body  = "union" , "(" , "enum" , ")" , "{" , { NL } ,
              { ( IDENT , [ ":" , type ] | func ) , [ "," ] , { NL } } , "}" ;

block       = "{" , { NL } , { stmt , ( NL | (* before *) "}" ) , { NL } } , "}" ;

stmt        = var_decl | assign | if_stmt | while_stmt | for_stmt | switch_stmt
            | "break" | "continue" | return_stmt | expr ;
var_decl    = ( "var" | "const" ) , IDENT , [ ":" , type ] , "=" , expr ;
assign      = place , "=" , expr ;
place       = IDENT , { "." , IDENT | "[" , expr , "]" } ;
if_stmt     = "if" , "(" , expr , ")" , block , [ "else" , ( if_stmt | block ) ] ;
while_stmt  = "while" , "(" , expr , ")" , block ;
for_stmt    = "for" , "(" , expr , ")" , "|" , IDENT , [ "," , IDENT ] , "|" , block ;
switch_stmt = "switch" , "(" , expr , ")" , "{" , { NL } , { arm , [ "," ] , { NL } } , "}" ;
arm         = ( "." , IDENT , { "," , "." , IDENT } | "else" ) , "=>" ,
              [ "|" , IDENT , "|" ] , block ;
return_stmt = "return" , [ expr ] ;

expr        = or_expr , { "catch" , or_expr } ;
or_expr     = and_expr , { "or" , and_expr } ;
and_expr    = cmp_expr , { "and" , cmp_expr } ;
cmp_expr    = add_expr , [ cmp_op , add_expr ] ;   (* not chainable: a < b < c is E002 *)
cmp_op      = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
add_expr    = mul_expr , { ( "+" | "-" ) , mul_expr } ;
mul_expr    = unary , { ( "*" | "/" | "%" ) , unary } ;
unary       = ( "-" | "!" | "try" | "&" ) , unary | postfix ;
postfix     = primary , { "." , IDENT , [ args ]            (* field, method call *)
                        | "[" , expr , "]"                  (* index *)
                        | "[" , expr , ".." , [ expr ] , "]"    (* slice *)
                        | struct_lit } ;                    (* after a capitalised type *)
struct_lit  = "{" , { NL } , { "." , IDENT , "=" , expr , [ "," ] , { NL } } , "}" ;
primary     = INT | STRING | "true" | "false"
            | IDENT , [ args ]                      (* variable, call, type name *)
            | BUILTIN , args                        (* @print(...) ... *)
            | "@This" , "(" , ")"
            | "." , IDENT                           (* enum member, typed by context *)
            | "error" , "." , IDENT
            | "[" , ( INT | "_" ) , "]" , type , "{" , [ expr , { "," , expr } , [ "," ] ] , "}"
            | "[" , "]" , type                      (* a slice type as a value *)
            | "struct" , struct_body                (* only as a type function's result *)
            | "(" , expr , ")" ;
args        = "(" , [ expr , { "," , expr } , [ "," ] ] , ")" ;

(* Lexical *)
IDENT       = letter_ , { letter_ | digit } ;      (* not a keyword *)
INT         = digit , { digit | "_" } ;            (* must fit in i64 *)
STRING      = '"' , { char | escape } , '"' ;      (* one line; escapes \n \t \\ \" \0 *)
BUILTIN     = "@" , IDENT ;
COMMENT     = "//" , { any char except newline } ;
KEYWORDS    = fn return if else while for break continue switch var const
              true false and or struct enum union try catch error inout comptime ;
