// @mulWide(a, b): the 128-bit product of two u64 as [2]u64{ low, high },
// against products computed with Ruby integers: zero, one, the largest
// u64 squared, 2^32 squared, and random values. The test suite runs it
// built normally (unsigned __int128 under gcc and clang) and in debug
// with EGG_PORTABLE (four 32-bit products), so both paths are checked.
// expect: 0 0
// expect: 1 0
// expect: 1 18446744073709551614
// expect: 18446744073709551614 1
// expect: 0 1
// expect: 18446744065119617025 0
// expect: 2465395958572223728 81621149086635842
// expect: 16045690984503098046 8022845492251549023
// expect: 4309411784670170944 2542121028733760735
// expect: 12083834523784442848 4401719692785025457
// expect: 3847022776394158601 2558360027420055359
// expect: 4922045381849030062 6493344754380044663
// expect: 340282366920938463463374607431768211455
uses io

fn main(io: Io) void {
    show(io, 0, 0)
    show(io, 1, 1)
    show(io, 18446744073709551615, 18446744073709551615)
    show(io, 18446744073709551615, 2)
    show(io, 4294967296, 4294967296)
    show(io, 4294967295, 4294967295)
    show(io, 81985529216486895, 18364758544493064720)
    show(io, 16045690984503098046, 9223372036854775809)
    show(io, 3617264691084272032, 12963899528013399522)
    show(io, 7631265484108281488, 10640095908876739470)
    show(io, 13426863218838564065, 3514850185411256873)
    show(io, 10572164659388749870, 11329852752533506881)
    io.print(all_ones(@mulWide(18446744073709551615, 18446744073709551615)[1]))
}

fn show(io: Io, a: u64, b: u64) void {
    const w = @mulWide(a, b)
    io.print(w[0], " ", w[1])
}

// (2^64 - 1)^2 + 2 (2^64 - 1) = 2^128 - 1: the halves add up as a 128-bit
// number would, carry and all.
fn all_ones(hi: u64) str {
    const lo2 = @mulWide(18446744073709551615, 2)
    var low = @mulWide(18446744073709551615, 18446744073709551615)[0]
    var high = hi
    const sum = low +% lo2[0]
    if (sum < low) {
        high = high + 1
    }
    low = sum
    high = high + lo2[1]
    if (low == 18446744073709551615 and high == 18446744073709551615) {
        return "340282366920938463463374607431768211455"
    }
    return "wrong"
}
