// A struct may hold a Buf of itself: a tree whose nodes own their
// children. a.free frees the whole tree.
// expect: 5
// expect: 1
uses alloc, io

const Node = struct {
    val: i64
    kids: Buf(Node)
}

fn main(a: Allocator, out: Io) void {
    var kids: Buf(Node) = .empty
    a.resize(&kids, 1, Node{ .val = 5, .kids = .empty })
    const n = Node{ .val = 1, .kids = kids }
    out.print(n.kids[0].val)
    out.print(@len(n.kids))
    a.free(n)
}
