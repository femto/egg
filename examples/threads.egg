// A thread runs a function. What it is given it owns, so no two threads can
// reach the same memory, and there is nothing to lock. A Thread must be
// joined or detached; a program ends when main does.
// expect: worker 1: 3
// expect: worker 2: 5
// expect: done
uses alloc, io, thread

fn work(io: Io, a: Allocator, id: i64, sink data: Buf(i64)) void {
    defer a.free(data)
    io.print("worker ", id, ": ", @len(data))
}

fn main(io: Io, a: Allocator, threads: Threads) void {
    const first = threads.spawn(work, io, a, 1, a.alloc(3, 0))
    first.join()
    const b = a.alloc(5, 0)
    const second = threads.spawn(work, io, a, 2, b)
    second.join()
    io.print("done")
}
