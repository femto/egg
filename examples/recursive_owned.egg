// An owned struct may hold a Buf of itself when it has a deinit:
// a.free on the root runs each node's deinit, which frees its children.
// expect: 5
// expect: 1
uses alloc, io

const Node = owned struct {
    val: i64
    kids: Buf(Node)

    fn deinit(sink self: Node, a: Allocator) void {
        a.free(self.kids)
        @drop(self)
    }
}

fn main(a: Allocator, out: Io) void {
    var kids: Buf(Node) = .empty
    a.push(&kids, Node{ .val = 5, .kids = .empty })
    const n = Node{ .val = 1, .kids = kids }
    out.print(n.kids[0].val)
    out.print(@len(n.kids))
    a.free(n)
}
