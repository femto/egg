// In a generic instance, a.free of a T that owns nothing does nothing, so
// one generic container serves owned and plain values alike.
// expect: 2
// expect: 1
// expect: 3
uses alloc, io

fn Slot(comptime V: type) type {
    return struct {
        val: V
        set: bool

        // Puts v in, or frees it if a value is already there.
        fn offer(inout self: @This(), a: Allocator, sink v: V) void {
            if (self.set) {
                a.free(v)
                return
            }
            a.free(@replace(&self.val, v))
            self.set = true
        }
    }
}

fn release(comptime T: type, a: Allocator, sink x: T) void {
    a.free(x)
}

fn main(io: Io, a: Allocator) void {
    var s = Slot(Buf(i64)){ .val = .empty, .set = false }
    s.offer(a, a.alloc(2, 7))
    s.offer(a, a.alloc(5, 7))
    io.print(@len(s.val))
    a.free(s)
    var n = Slot(i64){ .val = 0, .set = false }
    n.offer(a, 1)
    n.offer(a, 2)
    io.print(n.val)
    release(i64, a, 3)
    release(Buf(i64), a, a.alloc(3, 0))
    io.print(3)
}
