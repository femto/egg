// The alloc capability: text built at run time is a Buf(u8) its owner
// frees. A capability value can be kept in a struct.
// expect: n = 42
// expect: -7 and 0
// expect: 3 lines
// expect: 

uses alloc, io

const Log = struct {
    io: Io
    a: Allocator

    fn line(self: Log, label: str, n: i64) void {
        const text = self.a.int_str(n)
        defer self.a.free(text)
        const whole = self.a.concat(label, text)
        defer self.a.free(whole)
        self.io.print(whole)
    }
}

fn pair(a: Allocator, x: i64, y: i64) Buf(u8) {
    const first = a.int_str(x)
    defer a.free(first)
    const second = a.int_str(y)
    defer a.free(second)
    return a.concat(first, " and ", second)
}

fn main(io: Io, a: Allocator) void {
    const log = Log{ .io = io, .a = a }
    log.line("n = ", 42)
    const both = pair(a, -7, 0)
    defer a.free(both)
    io.print(both)
    const count = a.int_str(3)
    defer a.free(count)
    const lines = a.concat(count, " lines")
    defer a.free(lines)
    io.print(lines)
    const nothing = a.concat("", "")
    defer a.free(nothing)
    io.print(nothing)
}
