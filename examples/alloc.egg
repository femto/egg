// The alloc capability: strings built at run time live in an arena for
// the whole program. A capability value can be kept in a struct.
// expect: n = 42
// expect: -7 and 0
// expect: 3 lines
// expect: 

uses alloc, io

const Log = struct {
    io: Io
    a: Allocator

    fn line(self: Log, label: str, n: i64) void {
        self.io.print(self.a.concat(label, self.a.int_str(n)))
    }
}

fn pair(a: Allocator, x: i64, y: i64) str {
    return a.concat(a.int_str(x), a.concat(" and ", a.int_str(y)))
}

fn main(io: Io, a: Allocator) void {
    const log = Log{ .io = io, .a = a }
    log.line("n = ", 42)
    io.print(pair(a, -7, 0))
    io.print(a.concat(a.int_str(3), " lines"))
    io.print(a.concat("", ""))
}
