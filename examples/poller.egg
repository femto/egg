// One thread, many sockets: a Poller owns the connections added to it,
// waits until some are ready, and reads and writes them without blocking.
// Here it serves an echo server's listener and its clients, and a Waker
// from another thread ends the loop.
// expect: echoed 50 lines over 5 connections
// expect: woken
uses alloc, io, net, thread

const CLIENTS = 5
const LINES = 10

// A client: connects, sends LINES lines, reads them back.
fn client(net: Net, port: i64, a: Allocator, sink done: Sender(i64)) void {
    defer done.close()
    const c = net.tcp_connect("127.0.0.1", port) catch {
        done.send(0)
        return
    }
    defer c.close()
    c.set_timeout(5000) catch {}
    var got = 0
    var line: Buf(u8) = .empty
    defer a.free(line)
    var i = 0
    while (i < LINES) {
        c.write("ping\n") catch {
            break
        }
        if (c.read_line(a, &line) catch false) {
            if (line == "ping") {
                got = got + 1
            }
        }
        i = i + 1
    }
    done.send(got)
}

fn wake_later(sink w: Waker, sink go: Receiver(bool)) void {
    defer w.close()
    defer go.close()
    _ = go.recv()
    w.wake()
}

fn main(io: Io, net: Net, a: Allocator, threads: Threads) !void {
    const p = try net.poller()
    defer p.close()
    const listener = try net.tcp_listen("127.0.0.1", 0)
    const port = listener.port()
    const lt = try p.add_listener(listener)

    const results = threads.channel(i64, CLIENTS)
    defer results.close()
    var i = 0
    while (i < CLIENTS) {
        threads.spawn(client, net, port, a, results.sender()).detach()
        i = i + 1
    }
    const go = threads.channel(bool, 1)
    defer go.close()
    const start = go.sender()
    defer start.close()
    threads.spawn(wake_later, try p.waker(), go.clone()).detach()

    var events: Buf(PollEvent) = .empty
    defer a.free(events)
    var buf: Buf(u8) = .empty
    defer a.free(buf)
    var echoed = 0
    var finished = 0
    var woken = false
    while (!woken) {
        _ = try p.wait(a, &events, 5000)
        var k = 0
        while (k < @len(events)) {
            const e = events[k]
            k = k + 1
            if (e.token == -1) {
                woken = true
            } else if (e.token == lt) {
                // Every connection waiting to be taken.
                while (try p.accept(lt)) |c| {
                    _ = try p.add(c, .read)
                }
            } else if (e.readable or e.hangup) {
                if (try p.read(e.token, a, &buf, 4096)) |n| {
                    if (n == 0) {
                        const gone = try p.remove(e.token)
                        gone.close()
                    } else {
                        // Small writes to a fresh socket go out whole.
                        _ = try p.write(e.token, buf)
                        for (buf) |ch| {
                            if (ch == '\n') {
                                echoed = echoed + 1
                            }
                        }
                    }
                }
            }
        }
        // Once every client has reported, wake the loop from outside.
        while (results.recv_timeout(0)) |done| {
            _ = done
            finished = finished + 1
            if (finished == CLIENTS) {
                start.send(true)
            }
        }
    }
    io.print("echoed ", echoed, " lines over ", CLIENTS, " connections")
    io.print("woken")
}
