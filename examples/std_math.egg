// A module of the standard library is imported by name, without .egg:
// @import("std/math") is lib/std/math.egg beside the compiler.
// expect: 2
// expect: 9
// expect: 7
// expect: 10
// expect: 1.5
// expect: 0.0
// expect: 5
uses io

const math = @import("std/math")

fn main(io: Io) void {
    io.print(math.min(i64, 2, 9))
    io.print(math.max(i64, 2, 9))
    io.print(math.abs(i64, -7))
    io.print(math.clamp(i64, 42, 0, 10))
    io.print(math.abs(f64, -1.5))
    io.print(math.abs(f64, -0.0))
    io.print(math.abs(u64, 5))
}
