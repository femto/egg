// while loops, var vs const, if / else if / else.
// expect: 5050
// expect: 55
// expect: true
// expect: 3

uses io

fn sum_to(n: i64) i64 {
    var total = 0
    var i = 1
    while (i <= n) {
        total = total + i
        i = i + 1
    }
    return total
}

fn fib_iter(n: i64) i64 {
    var a = 0
    var b = 1
    var k = 0
    while (k < n) {
        const next = a + b
        a = b
        b = next
        k = k + 1
    }
    return a
}

fn is_even(n: i64) bool {
    return n % 2 == 0
}

fn classify(n: i64) i64 {
    if (n < 0) {
        return 1
    } else if (n == 0) {
        return 2
    } else {
        return 3
    }
}

fn main(out: Io) void {
    out.print(sum_to(100))
    out.print(fib_iter(10))
    out.print(is_even(42) and !is_even(7))
    out.print(classify(9))
}
