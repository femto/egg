// A small static file server: eggc run server.egg -- ROOT PORT
// HTTP/1.1 with keep-alive, on std/http. A fixed pool of threads takes
// connections from a queue, and a logger thread prints what they report. While every thread is busy and the queue is full,
// the server accepts one more connection and waits with it: load cannot make
// it start more threads. A connection holds its thread while it is open, so
// it may idle for 2 seconds and make 100 requests.
// An example, not for the open internet: symbolic links are followed out of
// ROOT.
uses alloc, args, fs, io, net, thread

const text = @import("std/text")
const http = @import("std/http")

const Worker = owned struct {
    t: Thread

    fn deinit(sink self: Worker) void {
        self.t.join()
        @forget(self)
    }
}

fn content_type(path: []u8) str {
    if (text.ends_with(path, ".html")) {
        return "text/html; charset=utf-8"
    }
    if (text.ends_with(path, ".txt")) {
        return "text/plain; charset=utf-8"
    }
    if (text.ends_with(path, ".json")) {
        return "application/json"
    }
    return "application/octet-stream"
}

// A request may not leave the root.
fn safe(path: []u8) bool {
    if (@len(path) == 0 or path[0] != '/') {
        return false
    }
    var i = 0
    while (i + 1 < @len(path)) {
        if (path[i] == '.' and path[i + 1] == '.') {
            return false
        }
        i = i + 1
    }
    return true
}

fn plain(s: []u8) bool {
    for (s) |c| {
        if (c < 32 or c > 126) {
            return false
        }
    }
    return true
}

fn respond(c: TcpConn, a: Allocator, req: http.Request, status: str, kind: str, body: []u8) !void {
    const headers = a.concat("Content-Type: ", kind, "\r\n")
    defer a.free(headers)
    return http.respond(c, a, req, status, "", headers, body)
}

fn serve_file(c: TcpConn, files: Fs, a: Allocator, root: str, req: http.Request, path: []u8) !i64 {
    const full = a.concat(root, path)
    defer a.free(full)
    const body = files.read(a, full) catch |e| {
        if (e == error.NotFound or e == error.IsDirectory) {
            try respond(c, a, req, "404 Not Found", "text/plain", "not found\n")
            return 404
        }
        try respond(c, a, req, "500 Internal Server Error", "text/plain", "cannot read\n")
        return 500
    }
    defer a.free(body)
    try respond(c, a, req, "200 OK", content_type(path), body)
    return 200
}

// What a request that could not be read gets, before the connection closes.
fn refuse(c: TcpConn, a: Allocator, e: anyerror) !void {
    if (e == error.HeadTooLarge) {
        return http.write_response(c, a, "431 Request Header Fields Too Large", "Content-Type: text/plain\r\n", "too long\n", false)
    }
    if (e == error.BodyTooLarge) {
        return http.write_response(c, a, "413 Payload Too Large", "Content-Type: text/plain\r\n", "too large\n", false)
    }
    if (e == error.BadRequest) {
        return http.write_response(c, a, "400 Bad Request", "Content-Type: text/plain\r\n", "bad request\n", false)
    }
    return e
}

fn handle(c: TcpConn, files: Fs, a: Allocator, root: str, log: Sender(Buf(u8))) !void {
    // Quiet for 2 s, between requests or inside one, and it is let go.
    try c.set_timeout(2000)
    var inbox: Buf(u8) = .empty
    defer a.free(inbox)
    var served = 0
    while (true) {
        const got = (http.read_request(c, a, &inbox, 65536) catch |e| {
            return refuse(c, a, e)
        }) orelse break
        var req = got
        defer req.deinit(a)
        served = served + 1
        // Only GET and HEAD are served, without a body: a client that sends
        // anything else is not one to keep talking to.
        const reads = req.method == "GET" or req.method == "HEAD"
        if (served >= 100 or !reads or @len(req.body) > 0) {
            http.close_after(&req)
        }
        try route(c, files, a, root, log, req)
        if (!req.keep) {
            return
        }
    }
}

fn route(c: TcpConn, files: Fs, a: Allocator, root: str, log: Sender(Buf(u8)), req: http.Request) !void {
    var status = 400
    const path = req.path[0..]
    if (req.method != "GET" and req.method != "HEAD") {
        status = 405
        try respond(c, a, req, "405 Method Not Allowed", "text/plain", "only GET\n")
    } else if (!safe(path)) {
        status = 403
        try respond(c, a, req, "403 Forbidden", "text/plain", "forbidden\n")
    } else if (text.ends_with(path, "/")) {
        const index = a.concat(path, "index.html")
        defer a.free(index)
        status = try serve_file(c, files, a, root, req, index)
    } else {
        status = try serve_file(c, files, a, root, req, path)
    }
    const code = a.int_str(status)
    defer a.free(code)
    // The path is the client's: nothing it holds may reach the terminal.
    if (plain(req.method) and plain(path)) {
        log.send(a.concat(code, " ", req.method, " ", path))
    } else {
        log.send(a.concat(code, " ?"))
    }
}

fn work(sink jobs: Receiver(TcpConn), files: Fs, a: Allocator, root: str, sink log: Sender(Buf(u8))) void {
    defer jobs.close()
    defer log.close()
    while (jobs.recv()) |c| {
        defer c.close()
        handle(c, files, a, root, log) catch {
            continue
        }
    }
}

fn logger(sink rx: Receiver(Buf(u8)), io: Io, a: Allocator) void {
    defer rx.close()
    while (rx.recv()) |line| {
        defer a.free(line)
        io.print(line)
    }
}

fn main(io: Io, args: Args, files: Fs, net: Net, a: Allocator, threads: Threads) !void {
    if (args.len() != 3) {
        io.eprint("usage: ", args.get(0), " ROOT PORT")
        return
    }
    const port = text.parse_int(args.get(2)) orelse -1
    if (port < 0 or port > 65535) {
        io.eprint("bad port: ", args.get(2))
        return
    }
    const server = try net.tcp_listen("127.0.0.1", port)
    defer server.close()
    io.eprint("listening on ", server.port())

    const rx = threads.channel(Buf(u8), 64)
    const log = rx.sender()
    const printer = threads.spawn(logger, rx, io, a)
    defer printer.join()
    defer log.close()        // before the join, or the logger would wait for it

    const jobs = threads.channel(TcpConn, 16)
    const queue = jobs.sender()
    var pool: Buf(Worker) = .empty
    defer a.free(pool)       // joins them
    defer queue.close()      // first: they finish what is queued, and stop
    var i = 0
    while (i < 8) {
        a.push(&pool, Worker{ .t = threads.spawn(work, jobs.clone(), files, a, args.get(1), log.clone()) })
        i = i + 1
    }
    jobs.close()             // the workers have their own
    while (true) {
        queue.send(try server.accept())
    }
}
