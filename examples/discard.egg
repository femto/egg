// _ = e evaluates e and drops its value on purpose. An error still has to
// be handled (_ = try f()), and an owned value cannot be dropped: it would
// never be freed. _ = x also counts as using x.
// expect: 3
// expect: 1
// expect: 2
// expect: tried
// expect: unused ok
// expect: 0
uses io, alloc

fn noisy(io: Io, n: i64) i64 {
    io.print(n)
    return n * 2
}

fn may(fail: bool) !i64 {
    if (fail) {
        return error.Bad
    }
    return 1
}

fn run(io: Io) !void {
    _ = try may(false)
    io.print("tried")
}

fn unused(io: Io, x: i64) void {
    _ = x
    io.print("unused ok")
}

fn main(io: Io, a: Allocator) void {
    _ = noisy(io, 3)
    _ = noisy(io, 1) + noisy(io, 2)
    _ = may(true) catch 0
    run(io) catch io.print("no")
    unused(io, 5)
    var b: Buf(i64) = .empty
    defer a.free(b)
    a.push(&b, 4)
    _ = a.pop(&b)
    io.print(@len(b))
}
