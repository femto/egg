// Operands and arguments are evaluated left to right on every C compiler.
// expect: 1
// expect: 2
// expect: 3
// expect: 1
// expect: 2
// expect: 10
// expect: 20
// expect: 30

uses io

fn one(io: Io) i64 {
    io.print(1)
    return 1
}

fn two(io: Io) i64 {
    io.print(2)
    return 2
}

fn show(io: Io, a: i64, b: i64) i64 {
    io.print(a * 10)
    io.print(b * 10)
    return a + b
}

fn main(io: Io) void {
    io.print(one(io) + two(io))
    io.print(show(io, one(io) - 0, two(io) * 1) * 10)
}
