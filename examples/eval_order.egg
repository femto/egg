// Operands and arguments are evaluated left to right on every C compiler.
// expect: 1
// expect: 2
// expect: 3
// expect: 1
// expect: 2
// expect: 10
// expect: 20
// expect: 30

uses io

fn one(out: Io) i64 {
    out.print(1)
    return 1
}

fn two(out: Io) i64 {
    out.print(2)
    return 2
}

fn show(out: Io, a: i64, b: i64) i64 {
    out.print(a * 10)
    out.print(b * 10)
    return a + b
}

fn main(out: Io) void {
    out.print(one(out) + two(out))
    out.print(show(out, one(out) - 0, two(out) * 1) * 10)
}
