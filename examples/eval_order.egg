// Operands and arguments are evaluated left to right on every C compiler.
// expect: 1
// expect: 2
// expect: 3
// expect: 1
// expect: 2
// expect: 10
// expect: 20
// expect: 30

fn one() i64 {
    @print(1)
    return 1
}

fn two() i64 {
    @print(2)
    return 2
}

fn show(a: i64, b: i64) i64 {
    @print(a * 10)
    @print(b * 10)
    return a + b
}

fn main() void {
    @print(one() + two())
    @print(show(one() - 0, two() * 1) * 10)
}
