// An index or slice bound of a column is computed before the column is
// looked up, so one that grows the list sees the column as it is after.
// expect: 1
// expect: 2
// expect: hi
// expect: 301
// expect: 10
// expect: 1
// expect: 1
uses alloc, io

const U = struct { id: i64, b: Buf(u8) }
const P = struct { x: i64 }

fn next(inout n: i64) i64 {
    const old = n
    n = n + 1
    return old
}

// Left to right: the list's place, then the column's index.
fn left_to_right(io: Io, a: Allocator) void {
    var lists: Buf(MultiArrayList(P)) = .empty
    defer a.free(lists)
    a.push(&lists, MultiArrayList(P).empty)
    a.push(&lists, MultiArrayList(P).empty)
    lists[0].append(a, P{ .x = 0 })
    lists[0].append(a, P{ .x = 1 })
    lists[1].append(a, P{ .x = 10 })
    lists[1].append(a, P{ .x = 11 })
    var n: i64 = 0
    io.print(lists[next(&n)].items(.x)[next(&n)])
    n = 0
    const r = &lists[next(&n)].items(.x)[next(&n)]
    io.print(r)
}

fn grow(a: Allocator, inout s: MultiArrayList(U)) i64 {
    var k: i64 = 0
    while (k < 100) {
        s.append(a, U{ .id = k + 10, .b = .empty })
        k = k + 1
    }
    return 0
}

fn slice_after_growth(io: Io, a: Allocator) void {
    var s: MultiArrayList(U) = .empty
    defer a.free(s)
    s.append(a, U{ .id = 1, .b = .empty })
    const v = s.items(.id)[grow(a, &s)..grow(a, &s) + 2]
    io.print(v[1])
}

fn main(io: Io, a: Allocator) void {
    var s: MultiArrayList(U) = .empty
    defer a.free(s)
    s.append(a, U{ .id = 1, .b = a.concat("hi", "") })
    io.print(s.items(.id)[grow(a, &s)])
    io.print(@len(s.items(.b)[grow(a, &s)]))
    const r = &s.items(.b)[grow(a, &s)]
    io.print(r)
    io.print(s.len())
    slice_after_growth(io, a)
    left_to_right(io, a)
}
