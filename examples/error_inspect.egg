// catch |e| names the error, an anyerror: compare it with ==, switch on it,
// name it with @errorName, pass it on, store it, or return it. The fallback
// of catch or orelse may be a value, return/break/continue, or a block; a
// block that gives no value must leave.
// expect: 10 / 2 = 5
// expect: 0: Zero
// expect: -3: negative
// expect: 99: too big (TooBig)
// expect: 4 / 2 = 2
// expect: codes 0 -1 -2
// expect: last error: TooBig
// expect: found 3
uses alloc, io

fn check(x: i64) !i64 {
    if (x == 0) {
        return error.Zero
    }
    if (x < 0) {
        return error.Neg
    }
    if (x > 50) {
        return error.TooBig
    }
    return x
}

fn half(x: i64) !i64 {
    const v = check(x) catch |e| return e
    return v / 2
}

fn explain(a: Allocator, e: anyerror) Buf(u8) {
    switch (e) {
        error.Neg => { return a.concat("", "negative") }
        error.TooBig => { return a.concat("too big (", @errorName(e), ")") }
        else => { return a.concat("", @errorName(e)) }
    }
}

fn code(e: anyerror) i64 {
    if (e == error.Zero) {
        return 0
    }
    if (e == error.Neg) {
        return -1
    }
    return -2
}

fn find(xs: []i64, want: i64) ?i64 {
    for (xs) |x, i| {
        if (x == want) {
            return i
        }
    }
    return null
}

fn main(io: Io, a: Allocator) void {
    const xs = [_]i64{ 10, 0, -3, 99, 4 }
    var last: anyerror = error.None
    for (xs) |x| {
        const v = half(x) catch |e| {
            const why = explain(a, e)
            defer a.free(why)
            io.print(x, ": ", why)
            last = e
            continue
        }
        io.print(x, " / 2 = ", v)
    }
    const c0 = half(0) catch |e| code(e)
    const c1 = half(-1) catch |e| code(e)
    const c2 = half(51) catch |e| code(e)
    io.print("codes ", c0, " ", c1, " ", c2)
    io.print("last error: ", @errorName(last))
    const i = find(xs[0..], 99) orelse {
        io.print("not found")
        return
    }
    io.print("found ", i)
}
