// opt == null and opt != null: whether an optional holds a value, for
// numbers, slices, structs and bools, from either side.
// expect: false true
// expect: true true
// expect: true true true
// expect: true true true
// expect: true
// expect: false false false
// expect: true
uses io, alloc

const Point = struct { x: i64, y: i64 }

fn find(xs: []i64, want: i64) ?i64 {
    for (xs) |x, i| {
        if (x == want) {
            return i
        }
    }
    return null
}

fn word(s: []u8) ?[]u8 {
    if (@len(s) == 0) {
        return null
    }
    return s[0..1]
}

fn pt(ok: bool) ?Point {
    if (ok) {
        return Point{ .x = 1, .y = 2 }
    }
    return null
}

fn main(io: Io, a: Allocator) void {
    const xs = [3]i64{ 5, 6, 7 }
    io.print(find(xs[0..], 6) == null, " ", find(xs[0..], 9) == null)
    io.print(null != find(xs[0..], 6), " ", null == find(xs[0..], 9))
    io.print(word("abc") != null, " ", word("") == null, " ", null == word(""))
    const p = pt(true)
    var q: ?Point = null
    io.print(p != null, " ", q == null, " ", null != p)
    q = pt(false)
    io.print(q == null)
    const b: ?bool = false
    io.print(b == null, " ", b orelse true, " ", null == b)
    var buf: Buf(u8) = .empty
    defer a.free(buf)
    a.append_str(&buf, "hi")
    io.print(word(buf) != null)
}
