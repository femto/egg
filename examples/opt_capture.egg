// if (x) |v| and while (x) |v|: the block runs with the value of an optional.
// expect: 7
// expect: none
// expect: 2
// expect: 1
// expect: 0
// expect: 3
// expect: 1
// expect: found 8
// expect: second 9
// expect: done
uses alloc, io

fn pick(n: i64) ?i64 {
    return if (n > 0) n else null
}

const Countdown = struct {
    n: i64

    fn next(inout self: Countdown) ?i64 {
        if (self.n == 0) {
            return null
        }
        self.n = self.n - 1
        return self.n
    }
}


fn main(io: Io, a: Allocator) void {
    if (pick(7)) |v| {
        io.print(v)
    } else {
        io.print("none")
    }
    if (pick(0)) |v| {
        io.print(v)
    } else {
        io.print("none")
    }
    var c = Countdown{ .n = 3 }
    while (c.next()) |v| {
        io.print(v)
    }
    // Owned values: the block owns what the optional held.
    var bufs: Buf(Buf(i64)) = .empty
    defer a.free(bufs)
    a.push(&bufs, a.alloc(1, 0))
    a.push(&bufs, a.alloc(3, 0))
    while (a.pop(&bufs)) |b| {
        defer a.free(b)
        io.print(@len(b))
    }
    if (a.pop(&bufs)) |b| {
        a.free(b)
    } else if (pick(8)) |v| {
        io.print("found ", v)
    }
    var d = Countdown{ .n = 10 }
    while (d.next()) |v| {
        if (v == 9) {
            continue
        }
        io.print("second ", v + 1)
        break
    }
    io.print("done")
}
