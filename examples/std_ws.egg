// std/ws on a connection: a client connects to a server thread, which
// picks a subprotocol and echoes what it gets: text, a binary message long
// enough for a 64-bit length, a text after a ping (answered by the
// server's read_message, the pong passed over by the client's), then the
// close handshake, started by the client. A second connection sends text
// that is not UTF-8, which the server closes with 1007. Then connect's
// errors: wss://, not a ws:// URL, a server that does not switch, and
// one that picks a protocol not offered (CHAT for chat). Last, a server
// that pings after the client's close frame, before its own: answered.
// First, frames as bytes: UTF-8, close payloads, and which end masks.
// expect: utf8 true true false false false false false true
// expect: close 1005 -1002
// expect: close 1 byte -1002
// expect: close reason -1007
// expect: split char 1 é
// expect: client unmasked 1 [hi]
// expect: client masked -1002
// expect: client to server 2 [abc] masked true
// expect: protocol chat
// expect: 1 echo: héllo
// expect: 2 70000 same true
// expect: 1 echo: after ping
// expect: close 1000 []
// expect: then Closed
// expect: bad text: close 1007
// expect: wss://127.0.0.1/ Unsupported
// expect: http://127.0.0.1/ BadUrl
// expect: plain http Handshake
// expect: CHAT for chat Handshake
// expect: after close 1000 [] pong [x]
// expect: server: close 1000 [bye]
// expect: server: -1007
uses alloc, io, net, thread, rand

const http = @import("std/http")
const ws = @import("std/ws")
const text = @import("std/text")

// One WebSocket connection from l, echoed until it closes; what came last
// goes in log.
fn session(l: TcpListener, a: Allocator, inout log: Buf(u8)) !void {
    const c = try l.accept()
    defer c.close()
    var inbox: Buf(u8) = .empty
    defer a.free(inbox)
    const req = (try http.read_request(c, a, &inbox, 0)) orelse return
    defer req.deinit(a)
    if (!ws.is_handshake(a, req)) {
        return http.respond(c, a, req, "400 Bad Request", "", "", "")
    }
    const offered = http.header_list(a, req, "Sec-WebSocket-Protocol")
    defer a.free(offered)
    const protocol = if (http.has_word(offered, "chat")) "chat" else ""
    const reply = ws.handshake(a, http.header(req, "Sec-WebSocket-Key") orelse "", protocol)
    defer a.free(reply)
    try c.write(reply)
    var conn = ws.server(@replace(&inbox, .empty))
    defer conn.deinit(a)
    var data: Buf(u8) = .empty
    defer a.free(data)
    while (true) {
        const kind = try ws.read_message(c, a, &conn, &data)
        if (kind == ws.TEXT) {
            const echo = a.concat("echo: ", data)
            defer a.free(echo)
            try ws.send(c, a, &conn, ws.TEXT, echo)
        } else if (kind == ws.BINARY) {
            try ws.send(c, a, &conn, ws.BINARY, data)
        } else {
            a.append_str(&log, "server: ")
            if (kind == ws.CLOSE) {
                a.append_str(&log, "close ")
                a.append_int(&log, ws.close_code(data))
                a.append_str(&log, " [")
                a.append_str(&log, ws.close_reason(data))
                a.append_str(&log, "]")
            } else {
                a.append_int(&log, kind)
            }
            a.append_str(&log, "\n")
            return
        }
    }
}

fn server(sink l: TcpListener, a: Allocator, sink out: Sender(Buf(u8))) void {
    defer out.close()
    defer l.close()
    var log: Buf(u8) = .empty
    var i = 0
    while (i < 2) {
        session(l, a, &log) catch |e| {
            a.append_str(&log, "server error ")
            a.append_str(&log, @errorName(e))
            a.append_str(&log, "\n")
        }
        i = i + 1
    }
    out.send(log)
}

// A server that answers anything with a plain 200.
fn plain(sink l: TcpListener, a: Allocator) void {
    defer l.close()
    const c = l.accept() catch { return }
    defer c.close()
    var inbox: Buf(u8) = .empty
    defer a.free(inbox)
    const req = (http.read_request(c, a, &inbox, 0) catch null) orelse return
    defer req.deinit(a)
    http.respond(c, a, req, "200 OK", "", "", "") catch {}
}

// A server that switches, naming protocol, for each of two connections;
// after the second's close frame it sends a ping and then its own close,
// and reports the frame that came back in out.
fn scripted(sink l: TcpListener, a: Allocator, sink out: Sender(Buf(u8))) void {
    defer out.close()
    defer l.close()
    var log: Buf(u8) = .empty
    scripted_one(l, a, "CHAT", false, &log) catch {}
    scripted_one(l, a, "", true, &log) catch |e| {
        a.append_str(&log, @errorName(e))
    }
    out.send(log)
}

fn scripted_one(l: TcpListener, a: Allocator, protocol: []u8, ping: bool, inout log: Buf(u8)) !void {
    const c = try l.accept()
    defer c.close()
    var inbox: Buf(u8) = .empty
    defer a.free(inbox)
    const req = (try http.read_request(c, a, &inbox, 0)) orelse return
    defer req.deinit(a)
    const reply = ws.handshake(a, http.header(req, "Sec-WebSocket-Key") orelse "", protocol)
    defer a.free(reply)
    try c.write(reply)
    if (!ping) {
        return
    }
    var conn = ws.server(@replace(&inbox, .empty))
    defer conn.deinit(a)
    var data: Buf(u8) = .empty
    defer a.free(data)
    var chunk: Buf(u8) = .empty
    defer a.free(chunk)
    var kind = ws.take(a, &conn, &data)
    while (kind == ws.NEED_MORE) {
        if (try c.read(a, &chunk, 4096) == 0) {
            return error.Closed
        }
        ws.received(a, &conn, chunk)
        kind = ws.take(a, &conn, &data)
    }
    // The client's close frame: a ping, then this end's close.
    try ws.send(c, a, &conn, ws.PING, "x")
    const bye = ws.close_frame(a, &conn, 1000, "")
    defer a.free(bye)
    try c.write(bye)
    kind = ws.take(a, &conn, &data)
    while (kind == ws.NEED_MORE) {
        if (try c.read(a, &chunk, 4096) == 0) {
            return error.Closed
        }
        ws.received(a, &conn, chunk)
        kind = ws.take(a, &conn, &data)
    }
    a.append_str(&log, if (kind == ws.PONG) "pong [" else "not pong [")
    a.append_str(&log, data)
    a.append_str(&log, "]")
}

fn url(a: Allocator, port: i64) Buf(u8) {
    var u = a.concat("ws://127.0.0.1:", "")
    a.append_int(&u, port)
    a.append_str(&u, "/chat")
    return u
}

fn chat(io: Io, net: Net, a: Allocator, rng: Random, port: i64) !void {
    var conn = ws.client(rng, a)
    defer conn.deinit(a)
    const to = url(a, port)
    defer a.free(to)
    const c = try ws.connect(net, a, &conn, to, "superchat, chat", "Origin: http://127.0.0.1\r\n")
    defer c.close()
    io.print("protocol ", conn.protocol)
    var data: Buf(u8) = .empty
    defer a.free(data)
    try ws.send(c, a, &conn, ws.TEXT, "héllo")
    const k1 = try ws.read_message(c, a, &conn, &data)
    io.print(k1, " ", data)
    var big: Buf(u8) = .empty
    defer a.free(big)
    var i = 0
    while (i < 70000) {
        a.push(&big, @as(u8, i % 251))
        i = i + 1
    }
    try ws.send(c, a, &conn, ws.BINARY, big)
    const k2 = try ws.read_message(c, a, &conn, &data)
    io.print(k2, " ", @len(data), " same ", data == big)
    try ws.send(c, a, &conn, ws.PING, "p")
    try ws.send(c, a, &conn, ws.TEXT, "after ping")
    const k3 = try ws.read_message(c, a, &conn, &data)
    io.print(k3, " ", data)
    try ws.close(c, a, &conn, 1000, "bye")
    const kind = try ws.read_message(c, a, &conn, &data)
    io.print(if (kind == ws.CLOSE) "close " else "not close ", ws.close_code(data), " [", ws.close_reason(data), "]")
    _ = ws.read_message(c, a, &conn, &data) catch |e| {
        io.print("then ", @errorName(e))
        return
    }
    io.print("then more")
}

fn bad_text(io: Io, net: Net, a: Allocator, rng: Random, port: i64) !void {
    var conn = ws.client(rng, a)
    defer conn.deinit(a)
    const to = url(a, port)
    defer a.free(to)
    const c = try ws.connect(net, a, &conn, to, "", "")
    defer c.close()
    try ws.send(c, a, &conn, ws.TEXT, "\xff")
    var data: Buf(u8) = .empty
    defer a.free(data)
    const kind = try ws.read_message(c, a, &conn, &data)
    io.print("bad text: ", if (kind == ws.CLOSE) "close " else "not close ", ws.close_code(data))
}

fn refused(io: Io, net: Net, a: Allocator, rng: Random, what: []u8, to: []u8, protocols: []u8) void {
    var conn = ws.client(rng, a)
    defer conn.deinit(a)
    const c = ws.connect(net, a, &conn, to, protocols, "") catch |e| {
        io.print(what, " ", @errorName(e))
        return
    }
    c.close()
    io.print(what, " connected")
}

// What a server's end takes from bytes (masked with a key of zeros).
fn taken(a: Allocator, bytes: []u8) i64 {
    var conn = ws.server(.empty)
    defer conn.deinit(a)
    var data: Buf(u8) = .empty
    defer a.free(data)
    ws.received(a, &conn, bytes)
    return ws.take(a, &conn, &data)
}

fn frames(io: Io, a: Allocator, rng: Random) void {
    io.print("utf8 ", text.is_utf8("h\xc3\xa9llo"), " ", text.is_utf8("\xf0\x9f\x98\x80"), " ", text.is_utf8("\xff"), " ", text.is_utf8("\xc0\x80"), " ", text.is_utf8("\xed\xa0\x80"), " ", text.is_utf8("\xf4\x90\x80\x80"), " ", text.is_utf8("\xe2\x82"), " ", text.is_utf8(""))
    io.print("close 1005 ", taken(a, "\x88\x82\x00\x00\x00\x00\x03\xed"))
    io.print("close 1 byte ", taken(a, "\x88\x81\x00\x00\x00\x00\x03"))
    io.print("close reason ", taken(a, "\x88\x83\x00\x00\x00\x00\x03\xe8\xff"))
    var srv = ws.server(.empty)
    defer srv.deinit(a)
    var data: Buf(u8) = .empty
    defer a.free(data)
    // é (C3 A9) split between two fragments.
    ws.received(a, &srv, "\x01\x81\x00\x00\x00\x00\xc3\x80\x81\x00\x00\x00\x00\xa9")
    const k = ws.take(a, &srv, &data)
    io.print("split char ", k, " ", data)
    var client = ws.client(rng, a)
    defer client.deinit(a)
    ws.received(a, &client, "\x81\x02hi")
    const k1 = ws.take(a, &client, &data)
    io.print("client unmasked ", k1, " [", data, "]")
    ws.received(a, &client, "\x81\x82\x00\x00\x00\x00hi")
    io.print("client masked ", ws.take(a, &client, &data))
    const f = ws.frame(a, &client, ws.BINARY, "abc")
    defer a.free(f)
    const masked = (f[1] & 0x80) != 0
    ws.received(a, &srv, f)
    const k2 = ws.take(a, &srv, &data)
    io.print("client to server ", k2, " [", data, "] masked ", masked)
}

// The code of the server's close frame, after the client's.
fn after_close(net: Net, a: Allocator, rng: Random, to: []u8) !i64 {
    var conn = ws.client(rng, a)
    defer conn.deinit(a)
    const c = try ws.connect(net, a, &conn, to, "", "")
    defer c.close()
    try ws.close(c, a, &conn, 1000, "")
    var data: Buf(u8) = .empty
    defer a.free(data)
    const kind = try ws.read_message(c, a, &conn, &data)
    return if (kind == ws.CLOSE) ws.close_code(data) else kind
}

fn main(io: Io, net: Net, a: Allocator, threads: Threads, rng: Random) !void {
    frames(io, a, rng)
    const l = try net.tcp_listen("127.0.0.1", 0)
    const port = l.port()
    const results = threads.channel(Buf(u8), 1)
    defer results.close()
    threads.spawn(server, l, a, results.sender()).detach()

    try chat(io, net, a, rng, port)
    try bad_text(io, net, a, rng, port)
    refused(io, net, a, rng, "wss://127.0.0.1/", "wss://127.0.0.1/", "")
    refused(io, net, a, rng, "http://127.0.0.1/", "http://127.0.0.1/", "")
    const p = try net.tcp_listen("127.0.0.1", 0)
    const plain_url = url(a, p.port())
    defer a.free(plain_url)
    threads.spawn(plain, p, a).detach()
    refused(io, net, a, rng, "plain http", plain_url, "")

    const s = try net.tcp_listen("127.0.0.1", 0)
    const scripted_url = url(a, s.port())
    defer a.free(scripted_url)
    const pongs = threads.channel(Buf(u8), 1)
    defer pongs.close()
    threads.spawn(scripted, s, a, pongs.sender()).detach()
    refused(io, net, a, rng, "CHAT for chat", scripted_url, "chat")
    const code = try after_close(net, a, rng, scripted_url)
    const pong = pongs.recv() orelse return
    defer a.free(pong)
    io.print("after close ", code, " [] ", pong)

    const log = results.recv() orelse return
    defer a.free(log)
    var line: Buf(u8) = .empty
    defer a.free(line)
    for (log) |ch| {
        if (ch == '\n') {
            io.print(line)
            a.resize(&line, 0, 0)
        } else {
            a.push(&line, ch)
        }
    }
}
