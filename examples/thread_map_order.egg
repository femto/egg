// A ConcurrentMap gives its pairs in the order they went in, whatever its
// hash key: a key put again keeps its place, one taken out and put back
// goes last. The same output under any EGG_HASH_SEED.
// expect: 0:0 74:100 10:3 47:4 84:5 20:6 57:7 94:8 30:9 67:10 3:11 40:12 77:13 13:14 50:15 87:16 23:17 60:18 97:19 33:20 70:21 6:22 43:23 80:24 16:25 53:26 90:27 26:28 63:29 100:30 36:31 73:32 9:33 46:34 83:35 19:36 56:37 93:38 29:39 37:99
// expect: replaced 2
uses io, alloc, thread

fn main(io: Io, a: Allocator, threads: Threads) void {
    const m = threads.map(i64, i64)
    defer m.close()
    var i = 0
    while (i < 40) {
        _ = m.put_new(a, (i * 37) % 101, i)
        i = i + 1
    }
    _ = m.remove(37)
    _ = m.put_new(a, 37, 99)
    const old = m.put(a, 74, 100) orelse -1
    const es = m.entries(a)
    defer a.free(es)
    var line = a.concat("", "")
    defer a.free(line)
    for (es) |e| {
        if (@len(line) > 0) {
            a.append_str(&line, " ")
        }
        a.append_int(&line, e.key)
        a.append_str(&line, ":")
        a.append_int(&line, e.val)
    }
    io.print(line)
    io.print("replaced ", old)
}
