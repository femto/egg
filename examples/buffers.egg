// Owned buffers: a.alloc makes one, a.free frees it, and the compiler
// checks that each is freed exactly once and never used after.
// expect: 10
// expect: 4
// expect: 30
// expect: 6
// expect: 25
// expect: 7
// expect: 0
// expect: 3
// expect: 12
uses alloc, io

const Point = struct { x: i64, y: i64 }

fn sum(xs: []i64) i64 {
    var total = 0
    for (xs) |x| {
        total = total + x
    }
    return total
}

// Takes ownership and gives it back: the caller owns the result.
fn doubled(a: Allocator, sink b: Buf(i64)) Buf(i64) {
    var out = a.alloc(@len(b), 0)
    for (b) |x, i| {
        out[i] = 2 * x
    }
    a.free(b)
    return out
}

// The caller keeps the buffer; this one grows it in place.
fn push(a: Allocator, inout b: Buf(i64), x: i64) void {
    const n = @len(b)
    a.resize(&b, n + 1, x)
}

fn squares(a: Allocator, n: i64) !Buf(i64) {
    var b = a.alloc(n, 0)
    errdefer a.free(b)
    var i = 0
    while (i < n) {
        if (i > 4) {
            return error.TooMany
        }
        b[i] = i * i
        i = i + 1
    }
    return b
}

fn main(io: Io, a: Allocator) !void {
    var b = a.alloc(4, 0)
    defer a.free(b)
    var i = 0
    while (i < @len(b)) {
        b[i] = i + 1
        i = i + 1
    }
    io.print(sum(b[0..]))
    io.print(@len(b))

    // Moved into doubled and back out again, into another variable.
    var d = doubled(a, a.alloc(3, 5))
    io.print(sum(d[0..]))
    push(a, &d, 7)
    io.print(@len(d) + 2)
    io.print(sum(d[1..3]) + d[3] - 2)
    const last = d[3]
    io.print(last)
    a.free(d)

    // The buffer is gone; the variable can own a new one.
    d = a.alloc(0, 0)
    io.print(@len(d))
    a.free(d)

    const pts = a.alloc(3, Point{ .x = 1, .y = 2 })
    defer a.free(pts)
    io.print(@len(pts))

    const sq = try squares(a, 3)
    defer a.free(sq)
    io.print(sq[1] + sq[2] + 7)
    const big = squares(a, 9) catch a.alloc(1, 0)
    a.free(big)
}
