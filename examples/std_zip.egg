// std/zip: an archive made by Info-ZIP read back, one built here and read
// back, names that are safe to use as paths, and damaged archives.
// expect: 4 entries, comment: test archive
// expect: hello.txt 0 11 11 33188 false [hello, zi]
// expect: docs/ 0 0 0 16877 true []
// expect: docs/fox.txt 8 1801 63 33188 false [the quick]
// expect: run.sh 0 18 18 33261 false [#!/bin/sh]
// expect: 1704164646 2 -1
// expect: BadName
// expect: a.txt 8 46 16 33188 false [plain tex]
// expect: tiny 0 2 2 33188 false [ab]
// expect: stored.txt 0 28 28 33188 false [kept as i]
// expect: dir/ 0 0 0 16877 true []
// expect: dir/café.sh 0 0 0 33261 false []
// expect: 1700000000 2048 0
// expect: 0 2048
// expect: 46 plain text
// expect: [a/b.txt] true
// expect: [dir/] true
// expect: [../x] false
// expect: [a/../../x] false
// expect: [/etc/passwd] false
// expect: [C:\x] false
// expect: [a//b] false
// expect: [./a] false
// expect: [] false
// expect: [a\b] false
// expect: [.. /x] false
// expect: [a./b] false
// expect: [a /b] false
// expect: [a/b.] false
// expect: BadData kept
// expect: BadChecksum kept
// expect: BadZip kept
// expect: - 0 18 18 4528 false [streamed ]
// expect: a.txt 8 38 19 33188 false [zip64 ent]
// expect: b.txt 0 7 7 33188 false [stored\n]
// expect: 74
// expect: 89 stored
// expect: BadZip
// expect: BadZip
// expect: BadZip
uses alloc, io

const zip = @import("std/zip")
const flate = @import("std/flate")
const codec = @import("std/codec")

// `zip -X -z -r t.zip hello.txt docs run.sh`, comment "test archive":
// hello.txt and run.sh (mode 755) stored, docs/fox.txt deflated.
const INFO_ZIP = ""

// One deflated entry, x.txt, whose data has "JUNK" after the stream, inside
// the size the archive gives it.
const JUNK = "UEsDBBQAAAAIAAAAIQA7fIrfDwAAABIAAAAFAAAAeC50eHTLSM3JyVfIQJBcAEpVTktQSwECHgMUAAAACAAAACEAO3yK3w8AAAASAAAABQAAAAAAAAAAAAAApIEAAAAAeC50eHRQSwUGAAAAAAEAAQAzAAAAMgAAAAAA"

// `printf 'streamed by zip -\n' | zip -X - -`: Info-ZIP writes ZIP64 end
// records when it cannot know the size in advance.
const STREAMED = "UEsDBC0AAAAAAEyEcF3XX7ue//////////8BABQALQEAEAASAAAAAAAAABIAAAAAAAAAc3RyZWFtZWQgYnkgemlwIC0KUEsBAh4DLQAAAAAATIRwXddfu54SAAAAEgAAAAEAAAAAAAAAAQAAALARAAAAAC1QSwYGLAAAAAAAAAAeAy0AAAAAAAAAAAABAAAAAAAAAAEAAAAAAAAALwAAAAAAAABFAAAAAAAAAFBLBgcAAAAAdAAAAAAAAAABAAAAUEsFBgAAAAABAAEALwAAAEUAAAAAAA=="

// Made by hand (and read back by Python's zipfile and unzip -t): every
// 32-bit size, offset and count is all ones, the values being in ZIP64
// extra fields and end records. a.txt is deflated, b.txt stored.
const ZIP64 = ""

// Every entry: name, method, size, packed size, mode, and the start of
// its contents.
fn list(io: Io, a: Allocator, ar: zip.Archive, data: []u8) !void {
    var i = 0
    while (i < ar.len()) {
        const e = ar.entries[i]
        var body: Buf(u8) = .empty
        defer a.free(body)
        try ar.read(a, &body, data, i)
        const shown = escaped(a, if (@len(body) > 9) body[0..9] else body[0..])
        defer a.free(shown)
        io.print(ar.name(i), " ", e.method, " ", e.size, " ", e.packed, " ", e.mode, " ", ar.is_dir(i), " [", shown, "]")
        i = i + 1
    }
}

// Newlines shown as \n.
fn escaped(a: Allocator, s: []u8) Buf(u8) {
    var out: Buf(u8) = .empty
    for (s) |c| {
        if (c == '\n') {
            a.append_str(&out, "\\n")
        } else {
            a.push(&out, c)
        }
    }
    return out
}

fn build(io: Io, a: Allocator) !Buf(u8) {
    var b = zip.builder()
    errdefer a.free(b)
    b.mtime = 1700000000
    try b.add(a, "a.txt", "plain text, plain text, plain text, plain text", flate.DEFAULT_LEVEL)
    try b.add(a, "tiny", "ab", 9)
    try b.add(a, "stored.txt", "kept as it is, kept as it is", 0)
    try b.add_dir(a, "dir")
    b.mode = 0x81ED
    try b.add(a, "dir/caf\u{e9}.sh", "", 6)
    b.add(a, "", "x", 6) catch |err| io.print(@errorName(err))
    return b.finish(a)
}

// Prints why data is not an archive that can be read.
fn refused(io: Io, a: Allocator, data: []u8) void {
    const ar = zip.open(a, data) catch |err| {
        io.print(@errorName(err))
        return
    }
    io.print("opened")
    a.free(ar)
}

fn latin_archive(a: Allocator) !Buf(u8) {
    var b = zip.builder()
    errdefer a.free(b)
    try b.add(a, "caf\xe9", "", 0)
    try b.add(a, "caf\xc3\xa9", "", 0)
    return b.finish(a)
}

fn main(io: Io, a: Allocator) !void {
    var data: Buf(u8) = .empty
    defer a.free(data)
    _ = codec.base64_decode(a, &data, INFO_ZIP)
    const ar = try zip.open(a, data)
    defer a.free(ar)
    io.print(ar.len(), " entries, comment: ", ar.comment)
    try list(io, a, ar, data)
    const t = ar.entries[0].mtime
    io.print(t, " ", ar.find("docs/fox.txt") orelse -1, " ", ar.find("nope") orelse -1)

    const made = try build(io, a)
    defer a.free(made)
    const back = try zip.open(a, made)
    defer a.free(back)
    try list(io, a, back, made)
    io.print(back.entries[0].mtime, " ", back.entries[4].flags, " ", @len(back.comment))

    // A name that is not UTF-8 is not marked as UTF-8.
    const latin = try latin_archive(a)
    defer a.free(latin)
    const lat = try zip.open(a, latin)
    defer a.free(lat)
    io.print(lat.entries[0].flags, " ", lat.entries[1].flags)

    // Bytes before the archive, as a self-extracting one has.
    const prefixed = a.concat("#!/bin/sh\nexit 0\n", made)
    defer a.free(prefixed)
    const pre = try zip.open(a, prefixed)
    defer a.free(pre)
    var body: Buf(u8) = .empty
    defer a.free(body)
    try pre.read(a, &body, prefixed, 0)
    io.print(@len(body), " ", body[0..10])

    const names = [_]str{ "a/b.txt", "dir/", "../x", "a/../../x", "/etc/passwd", "C:\\x", "a//b", "./a", "", "a\\b", ".. /x", "a./b", "a /b", "a/b." }
    for (names) |n| {
        io.print("[", n, "] ", zip.safe_name(n))
    }

    // Damage: a flipped byte in deflated data, in stored data, and an archive
    // cut short.
    var bad = a.concat(data, "")
    defer a.free(bad)
    bad[140] = bad[140] ^ 0x55
    var out = a.concat("kept", "")
    defer a.free(out)
    ar.read(a, &out, bad, 2) catch |err| io.print(@errorName(err), " ", out)
    bad[140] = bad[140] ^ 0x55
    bad[39] = bad[39] ^ 1
    const crc = try zip.open(a, bad)
    defer a.free(crc)
    crc.read(a, &out, bad, 0) catch |err| io.print(@errorName(err), " ", out)
    var junk: Buf(u8) = .empty
    defer a.free(junk)
    _ = codec.base64_decode(a, &junk, JUNK)
    const j = try zip.open(a, junk)
    defer a.free(j)
    j.read(a, &out, junk, 0) catch |err| io.print(@errorName(err), " ", out)
    // ZIP64: streamed, made by hand, and with bytes before it.
    var streamed: Buf(u8) = .empty
    defer a.free(streamed)
    _ = codec.base64_decode(a, &streamed, STREAMED)
    const st = try zip.open(a, streamed)
    defer a.free(st)
    try list(io, a, st, streamed)
    var z64: Buf(u8) = .empty
    defer a.free(z64)
    _ = codec.base64_decode(a, &z64, ZIP64)
    const big = try zip.open(a, z64)
    defer a.free(big)
    try list(io, a, big, z64)
    io.print(big.entries[1].offset)
    const z64pre = a.concat("MZ prefix bytes", z64)
    defer a.free(z64pre)
    const pre64 = try zip.open(a, z64pre)
    defer a.free(pre64)
    var b64: Buf(u8) = .empty
    defer a.free(b64)
    try pre64.read(a, &b64, z64pre, 1)
    io.print(pre64.entries[1].offset, " ", b64[0..6])
    // An entry whose ZIP64 field is missing (its id changed), and a count
    // past what an i64 holds.
    var z64bad = a.concat(z64, "")
    defer a.free(z64bad)
    z64bad[187] = 2
    refused(io, a, z64bad)
    z64bad[187] = 1
    z64bad[333] = 0x80
    refused(io, a, z64bad)

    const cut = zip.open(a, data[0..@len(data) - 30]) catch |err| {
        io.print(@errorName(err))
        return
    }
    a.free(cut)
}
