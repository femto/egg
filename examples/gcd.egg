// Euclid's algorithm, multi-line expressions, logical operators.
// expect: 21
// expect: false

uses io

fn gcd(a: i64, b: i64) i64 {
    var x = a
    var y = b
    while (y != 0) {
        const t = x % y
        x = y
        y = t
    }
    return x
}

fn main(out: Io) void {
    const g = gcd(1071,
                  462)
    out.print(g)
    out.print(g > 100 or
           g < 0)
}
