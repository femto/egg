// A character literal is one byte in single quotes: an integer literal
// ('a' is 97), so it takes its type from the context, i64 for a byte of
// a str, u8 for a Buf(u8).
// expect: 3
// expect: 25
// expect: 104
// expect: true
// expect: 149
// expect: 255
// expect: id_7
uses io, alloc

fn count(s: []u8, c: u8) i64 {
    var n = 0
    for (s) |b| {
        if (b == c) {
            n = n + 1
        }
    }
    return n
}

fn is_digit(c: i64) bool {
    return c >= '0' and c <= '9'
}

fn main(out: Io, a: Allocator) void {
    out.print(count("a,b,,c", ','))
    const z: u8 = 'z'
    out.print(z - 'a')
    out.print('h')
    out.print(is_digit("x7"[1]))
    out.print('\\' + '\"' + '\0' + '\n' + '\r')
    out.print(@as(u8, '\xff'))
    var b: Buf(u8) = .empty
    defer a.free(b)
    a.append_str(&b, "id-7")
    var i = 0
    while (i < @len(b)) {
        if (b[i] == '-') {
            b[i] = '_'
        }
        i = i + 1
    }
    out.print(b)
}
