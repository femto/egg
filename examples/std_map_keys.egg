// HashMap keys of any shape that has a canonical form: a struct, an enum,
// a union, an array, nested; text inside a key as a Buf(u8). They hash
// and compare by what they hold, with nothing to write. A float is keyed
// by its bits (@floatBits), which NaN and -0.0 make the honest choice.
// expect: 2 rooms
// expect: general/ann 2, random/ann 1
// expect: ab|c and a|bc are 2 keys
// expect: 0.5 -> half, -0.0 apart from 0.0: true
uses alloc, io

const map = @import("std/map")

const Kind = enum { room, direct }

const Where = struct {
    kind: Kind
    room: Buf(u8)
    user: Buf(u8)
}

const Pair = struct {
    a: Buf(u8)
    b: Buf(u8)
}

fn at(a: Allocator, room: []u8, user: []u8) Where {
    return Where{ .kind = .room, .room = a.concat(room, ""), .user = a.concat(user, "") }
}

fn main(io: Io, a: Allocator) void {
    var unread = map.HashMap(Where, i64).init()
    defer a.free(unread)
    unread.put(a, at(a, "general", "ann"), 1)
    unread.put(a, at(a, "random", "ann"), 1)
    unread.put(a, at(a, "general", "ann"), 2)            // the same key again
    var rooms = map.HashMap(Buf(u8), bool).init()
    defer a.free(rooms)
    for (unread.entries) |e| {
        rooms.put_text(a, e.key.room, true)
    }
    io.print(rooms.count(), " rooms")
    const g = at(a, "general", "ann")
    defer a.free(g)
    const r = at(a, "random", "ann")
    defer a.free(r)
    io.print("general/ann ", unread.get(g) orelse 0, ", random/ann ", unread.get(r) orelse 0)

    var pairs = map.HashMap(Pair, i64).init()
    defer a.free(pairs)
    pairs.put(a, Pair{ .a = a.concat("ab", ""), .b = a.concat("c", "") }, 1)
    pairs.put(a, Pair{ .a = a.concat("a", ""), .b = a.concat("bc", "") }, 2)
    io.print("ab|c and a|bc are ", pairs.count(), " keys")

    var names = map.HashMap(u64, str).init()
    defer a.free(names)
    names.put(a, @floatBits(0.5), "half")
    names.put(a, @floatBits(0.0), "zero")
    io.print("0.5 -> ", names.get(@floatBits(0.5)) orelse "?", ", -0.0 apart from 0.0: ", names.get(@floatBits(-0.0)) == null)
}
