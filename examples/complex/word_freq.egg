// Word frequencies: split a text into lowercase words, count them in a
// HashMap(Buf(u8), i64) looked up by the word being built, then print
// them most frequent first, ties in alphabetical order.
// expect: the: 5
// expect: cat: 3
// expect: and: 2
// expect: hat: 2
// expect: didn't: 1
// expect: ran: 1
// expect: sat: 1
// expect: then: 1
uses io, alloc

const map = @import("std/map")
const sort = @import("std/sort")

fn is_letter(c: i64) bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '\''
}

fn lower(c: i64) u8 {
    return if (c >= 'A' and c <= 'Z') @as(u8, c - 'A' + 'a') else @as(u8, c)
}

const Row = owned struct {
    word: Buf(u8)
    n: i64

    fn deinit(sink self: Row, a: Allocator) void {
        a.free(self.word)
        @drop(self)
    }
}

fn before(x: Row, y: Row) bool {
    return x.n > y.n or (x.n == y.n and x.word < y.word)
}

fn main(io: Io, a: Allocator) void {
    const text = "The cat and the hat. The cat sat; the HAT didn't. And then the cat ran!"
    var counts = map.HashMap(Buf(u8), i64).init()
    defer a.free(counts)
    var word: Buf(u8) = .empty
    defer a.free(word)
    var i = 0
    while (i <= @len(text)) {
        const c = if (i < @len(text)) text[i] else ' '
        if (is_letter(c)) {
            a.push(&word, lower(c))
        } else if (@len(word) > 0) {
            counts.put_text(a, word, (counts.get_text(word) orelse 0) + 1)
            a.resize(&word, 0, 0)
        }
        i = i + 1
    }
    var rows: Buf(Row) = .empty
    defer a.free(rows)
    for (counts.entries) |e| {
        a.push(&rows, Row{ .word = a.concat(e.key, ""), .n = e.val })
    }
    sort.sort_by(Row, &rows[0..], before)
    for (rows) |r| {
        io.print(r.word, ": ", r.n)
    }
}
