// defer runs when its block is left, last deferred first: at the end of
// the block, at return, break and continue, and when a try returns an
// error. errdefer runs only when the function returns an error.
// expect: 2
// expect: 1
// expect: 11
// expect: 10
// expect: 11
// expect: 10
// expect: 10
// expect: 99
// expect: 20
// expect: 7
// expect: 31
// expect: 30
// expect: 41
// expect: 40
// expect: 8
// expect: 5
// expect: 50
// expect: 9
uses io

fn fails(fail: bool) !i64 {
    if (fail) {
        return error.Bad
    }
    return 7
}

fn order(io: Io) void {
    defer io.print(1)
    defer io.print(2)
}

fn loop(io: Io) void {
    var i = 0
    while (i < 3) {
        defer io.print(10)
        i = i + 1
        if (i == 3) {
            break
        }
        defer io.print(11)
        continue
    }
    io.print(99)
}

fn early(io: Io) i64 {
    defer io.print(20)
    return 7
}

fn attempt(io: Io, fail: bool, base: i64) !i64 {
    defer io.print(base)
    errdefer io.print(base + 1)
    const n = try fails(fail)
    return n
}

fn pass_on(io: Io, fail: bool) !i64 {
    errdefer io.print(5)
    defer io.print(8)
    return fails(fail)
}

fn main(io: Io) !void {
    order(io)
    loop(io)
    io.print(early(io))
    const x = attempt(io, true, 30) catch 0
    const y = attempt(io, true, 40) catch 0
    const z = pass_on(io, true) catch 0
    const w = attempt(io, false, 50) catch 0
    io.print(x + y + z + w + 2)
}
