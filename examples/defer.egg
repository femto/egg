// defer runs when its block is left, last deferred first: at the end of
// the block, at return, break and continue, and when a try returns an
// error. errdefer runs only when the function returns an error.
// expect: 2
// expect: 1
// expect: 11
// expect: 10
// expect: 11
// expect: 10
// expect: 10
// expect: 99
// expect: 20
// expect: 7
// expect: 31
// expect: 30
// expect: 41
// expect: 40
// expect: 8
// expect: 5
// expect: 50
// expect: 9
uses io

fn fails(fail: bool) !i64 {
    if (fail) {
        return error.Bad
    }
    return 7
}

fn order(out: Io) void {
    defer out.print(1)
    defer out.print(2)
}

fn loop(out: Io) void {
    var i = 0
    while (i < 3) {
        defer out.print(10)
        i = i + 1
        if (i == 3) {
            break
        }
        defer out.print(11)
        continue
    }
    out.print(99)
}

fn early(out: Io) i64 {
    defer out.print(20)
    return 7
}

fn attempt(out: Io, fail: bool, base: i64) !i64 {
    defer out.print(base)
    errdefer out.print(base + 1)
    const n = try fails(fail)
    return n
}

fn pass_on(out: Io, fail: bool) !i64 {
    errdefer out.print(5)
    defer out.print(8)
    return fails(fail)
}

fn main(out: Io) !void {
    order(out)
    loop(out)
    out.print(early(out))
    const x = attempt(out, true, 30) catch 0
    const y = attempt(out, true, 40) catch 0
    const z = pass_on(out, true) catch 0
    const w = attempt(out, false, 50) catch 0
    out.print(x + y + z + w + 2)
}
