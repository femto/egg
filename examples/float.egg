// f32 and f64: literals from context, IEEE arithmetic, checked casts to
// integers, and the shortest round-trip printing.
// expect: 0.30000000000000004
// expect: 0.3
// expect: 100.0
// expect: 1234567.0
// expect: 1e+16
// expect: 0.0001
// expect: 1e-05
// expect: -0.0
// expect: -0.0
// expect: 5e-324
// expect: nan
// expect: -inf
// expect: 16777216.0
// expect: 255
// expect: -128
// expect: 9223372036854774784
// expect: 18446744073709549568
// expect: true
// expect: false
// expect: 2.5 of 10.0
uses io, alloc

const Point = struct {
    x: f64
    y: f64

    fn dot(self: Point, o: Point) f64 {
        return self.x * o.x + self.y * o.y
    }
}

fn main(io: Io, a: Allocator) void {
    io.print(0.1 + 0.2)
    const t: f32 = 0.1
    io.print(t + 0.2)
    io.print(100.0)
    io.print(1_234_567.0)
    io.print(1e16)
    io.print(0.0001)
    io.print(0.00001)
    io.print(-0.0)
    const nz: f64 = -0               // an integer literal keeps the sign too
    io.print(nz)
    io.print(5e-324)
    const zero = 0.0
    io.print(zero / zero)
    io.print(-1 / zero)
    const big: f32 = 16777217        // rounds: f32 has 24 bits of mantissa
    io.print(big)
    io.print(@as(u8, 255.9))
    io.print(@as(i8, -128.9))
    io.print(@as(i64, 9223372036854774784.0))
    io.print(@as(u64, 18446744073709549568.0))
    const p = Point{ .x = 1.5, .y = 2 }
    io.print(p.dot(p) == 6.25)
    io.print(zero / zero == zero / zero)
    const part = a.float_str(2.5)
    defer a.free(part)
    const whole = a.float_str(10)
    defer a.free(whole)
    const share = a.concat(part, " of ", whole)
    defer a.free(share)
    io.print(share)
}
