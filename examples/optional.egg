// ?T values: pop returns one, orelse unwraps it. A Buf(?i64) pops a ??i64,
// so it takes two orelses: the outer one for an empty buffer, the inner
// one for a null element. orelse return may end an index or a slice.
// A literal takes its type from the T of a ?T.
// expect: 4
// expect: 1
// expect: 7
// expect: 10
// expect: 2
// expect: 3
uses alloc, io

fn show(xs: []i64, a: Allocator, io: Io) void {
    var b: Buf(i64) = .empty
    defer a.free(b)
    a.push(&b, 1)
    a.push(&b, 0)
    io.print(xs[a.pop(&b) orelse return])
    io.print(@len(xs[a.pop(&b) orelse return..]))
    io.print(xs[a.pop(&b) orelse return])
}

fn main(a: Allocator, io: Io) void {
    var b: Buf(?i64) = .empty
    defer a.free(b)
    a.push(&b, null)
    a.push(&b, 4)
    io.print((a.pop(&b) orelse 0) orelse 1)
    io.print((a.pop(&b) orelse 0) orelse 1)
    io.print((a.pop(&b) orelse 7) orelse 1)
    const xs = [_]i64{ 10, 20, 30 }
    show(xs[0..], a, io)
    const n: ?i32 = 3
    io.print(n orelse 0)
}
