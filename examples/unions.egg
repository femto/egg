// Tagged unions (union(enum)) with payloads and methods, and switch:
// exhaustive, with payload capture, and `break` leaving the loop.
// expect: round
// expect: 24
// expect: green
// expect: red
// expect: 10
// expect: 1
// expect: 0

uses io

const Size = struct { w: i64, h: i64 }

const Shape = union(enum) {
    circle: i64
    rect: Size
    empty

    fn area(self: Shape) i64 {
        switch (self) {
            .circle => |r| {
                return 3 * r * r
            }
            .rect => |s| {
                return s.w * s.h
            }
            .empty => {
                return 0
            }
        }
    }
}

const Light = enum { red, yellow, green }

fn next(l: Light) Light {
    switch (l) {
        .red => {
            return .green
        }
        .green => {
            return .yellow
        }
        .yellow => {
            return .red
        }
    }
}

fn is_round(s: Shape) bool {
    switch (s) {
        .circle => {
            return true
        }
        else => {
            return false
        }
    }
}

fn main(io: Io) void {
    const shapes = [3]Shape{ Shape{ .circle = 2 }, Shape{ .rect = Size{ .w = 3, .h = 4 } }, .empty }
    var total = 0
    for (shapes) |s| {
        total = total + s.area()
        if (is_round(s)) {
            io.print("round")
        }
    }
    io.print(total)
    io.print(next(.red))
    io.print(next(Light.yellow))
    var n = 0
    while (n < 10) {
        switch (next(.green)) {
            .red => {
                break
            }
            .green, .yellow => {
                n = n + 1
            }
        }
    }
    io.print(n)
    var spins = 0
    while (true) {
        spins = spins + 1
        switch (next(.yellow)) {
            .red => {
                break
            }
            else => {
                continue
            }
        }
    }
    io.print(spins)
    const e = Shape.empty
    io.print(e.area())
}
