// std/http on a connection: a client thread sends pipelined requests at
// once, and the server reads them with read_request and answers each, with
// validators (conditional), ranges (ranged), HEADs (a length but no body)
// and a chunked body, until one asks to close. The client prints what
// came back, CRLF shown as |.
// expect: HTTP/1.1 200 OK|ETag: "v1"|Content-Length: 5|Connection: keep-alive||fresh
// expect: HTTP/1.1 200 OK|ETag: "v1"|Content-Length: 5|Connection: keep-alive||
// expect: HTTP/1.1 206 Partial Content|Accept-Ranges: bytes|Content-Range: bytes 2-4/10|Content-Length: 3|Connection: keep-alive||
// expect: HTTP/1.1 304 Not Modified|ETag: "v1"|Connection: keep-alive||
// expect: HTTP/1.1 206 Partial Content|Accept-Ranges: bytes|Content-Range: bytes 2-4/10|Content-Length: 3|Connection: keep-alive||234
// expect: HTTP/1.1 206 Partial Content|Accept-Ranges: bytes|Content-Range: bytes 7-9/10|Content-Length: 3|Connection: keep-alive||789
// expect: HTTP/1.1 416 Range Not Satisfiable|Accept-Ranges: bytes|Content-Range: bytes */10|Content-Length: 0|Connection: keep-alive||
// expect: HTTP/1.1 200 OK|Content-Length: 15|Connection: keep-alive||abcde 127.0.0.1
// expect: HTTP/1.1 200 OK|Content-Length: 3|Connection: close||bye
// expect: served 9
uses alloc, io, net, thread

const http = @import("std/http")

const REQUESTS = "GET /etag HTTP/1.1\r\nHost: x\r\n\r\nHEAD /etag HTTP/1.1\r\n\r\nHEAD /range HTTP/1.1\r\nRange: bytes=2-4\r\n\r\nGET /etag HTTP/1.1\r\nIf-None-Match: \"v0\", W/\"v1\"\r\n\r\nGET /range HTTP/1.1\r\nRange: bytes=2-4\r\n\r\nGET /range HTTP/1.1\r\nRange: bytes=-3\r\n\r\nGET /range HTTP/1.1\r\nRange: bytes=20-\r\n\r\nPOST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nab\r\n3\r\ncde\r\n0\r\n\r\nGET /bye HTTP/1.1\r\nConnection: close\r\n\r\n"

fn client(net: Net, port: i64, a: Allocator, sink out: Sender(Buf(u8))) void {
    defer out.close()
    const c = net.tcp_connect("127.0.0.1", port) catch {
        out.send(a.concat("cannot connect", ""))
        return
    }
    defer c.close()
    c.write(REQUESTS) catch {
        out.send(a.concat("cannot write", ""))
        return
    }
    const got = c.read_all(a) catch {
        out.send(a.concat("cannot read", ""))
        return
    }
    out.send(got)
}

fn answer(c: TcpConn, a: Allocator, req: http.Request) !void {
    if (req.path == "/etag") {
        return http.conditional(c, a, req, "\"v1\"", "", "", "fresh")
    }
    if (req.path == "/range") {
        return http.ranged(c, a, req, "", "0123456789")
    }
    if (req.path == "/echo") {
        const body = a.concat(req.body, " ", req.peer_ip)
        defer a.free(body)
        return http.respond(c, a, req, "200 OK", "", "", body)
    }
    return http.respond(c, a, req, "200 OK", "", "", "bye")
}

// Answers the requests on c until one does not keep it; how many.
fn serve(sink c: TcpConn, a: Allocator) !i64 {
    defer c.close()
    try c.set_timeout(5000)
    var inbox: Buf(u8) = .empty
    defer a.free(inbox)
    var served = 0
    while (true) {
        const req = (try http.read_request(c, a, &inbox, 1024)) orelse break
        defer req.deinit(a)
        try answer(c, a, req)
        served = served + 1
        if (!req.keep) {
            break
        }
    }
    return served
}

fn main(io: Io, net: Net, a: Allocator, threads: Threads) !void {
    const listener = try net.tcp_listen("127.0.0.1", 0)
    defer listener.close()
    const results = threads.channel(Buf(u8), 1)
    defer results.close()
    threads.spawn(client, net, listener.port(), a, results.sender()).detach()

    const c = try listener.accept()
    const served = try serve(c, a)

    const got = results.recv() orelse return
    defer a.free(got)
    // One response a line, CRLF as |.
    var line: Buf(u8) = .empty
    defer a.free(line)
    var i = 0
    while (i < @len(got)) {
        if (i + 1 < @len(got) and got[i] == '\r' and got[i + 1] == '\n') {
            a.push(&line, '|')
            i = i + 2
        } else {
            a.push(&line, got[i])
            i = i + 1
        }
        // A response ends after its body; the next starts with HTTP/1.1.
        if (i < @len(got) and i + 9 <= @len(got) and got[i..i + 9] == "HTTP/1.1 ") {
            io.print(line)
            a.resize(&line, 0, 0)
        }
    }
    io.print(line)
    io.print("served ", served)
}
