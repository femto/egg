// Comptime generics: a type function and a generic function.
// expect: 2
// expect: 3
// expect: 9
// expect: false
// expect: 16
// expect: Pair(bool)
// expect: [3]i64

uses io

fn Pair(comptime T: type) type {
    return struct {
        a: T
        b: T

        fn swap(self: @This()) @This() {
            return @This(){ .a = self.b, .b = self.a }
        }
    }
}

fn max(comptime T: type, a: T, b: T) T {
    if (a > b) {
        return a
    }
    return b
}

fn sum_pair(p: Pair(i64)) i64 {
    return p.a + p.b
}

const Wrapper = struct {
    inner: Pair(bool)
}

fn main(out: Io) void {
    const p = Pair(i64){ .a = 1, .b = 2 }
    const q = p.swap()
    out.print(q.a)
    out.print(sum_pair(q))
    out.print(max(i64, 3, 9))
    const w = Wrapper{ .inner = Pair(bool){ .a = true, .b = false } }
    out.print(w.inner.swap().a)
    out.print(@sizeOf(Pair(i64)))
    out.print(@typeName(Pair(bool)))
    out.print(@typeName([3]i64))
}
