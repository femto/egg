// Comptime generics: a type function and a generic function.
// expect: 2
// expect: 3
// expect: 9
// expect: false
// expect: 16
// expect: Pair(bool)
// expect: [3]i64

fn Pair(comptime T: type) type {
    return struct {
        a: T
        b: T

        fn swap(self: @This()) @This() {
            return @This(){ .a = self.b, .b = self.a }
        }
    }
}

fn max(comptime T: type, a: T, b: T) T {
    if (a > b) {
        return a
    }
    return b
}

fn sum_pair(p: Pair(i64)) i64 {
    return p.a + p.b
}

const Wrapper = struct {
    inner: Pair(bool)
}

fn main() void {
    const p = Pair(i64){ .a = 1, .b = 2 }
    const q = p.swap()
    @print(q.a)
    @print(sum_pair(q))
    @print(max(i64, 3, 9))
    const w = Wrapper{ .inner = Pair(bool){ .a = true, .b = false } }
    @print(w.inner.swap().a)
    @print(@sizeOf(Pair(i64)))
    @print(@typeName(Pair(bool)))
    @print(@typeName([3]i64))
}
