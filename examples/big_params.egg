// A plain parameter larger than 16 bytes goes as a const pointer in C, not
// a copy; what a program sees is the same. m.mix(m.last), where an inout
// self is called with a part of itself, still sees that part as it was
// before the call, and so does an argument a later one changes.
// expect: 3 4
// expect: 10 1 6
// expect: 32 32
// expect: 8
// expect: 3
// expect: 11
// expect: 9
// expect: 1 3
// expect: 12 3 0
// expect: 7 -1 4 -1
// expect: 8080
uses io, alloc, thread, net

// Kinds sized like structs: a union, an optional, an Addr (32 bytes).
const Shape = union(enum) { box: [4]i64, name: str, dot }

fn area(s: Shape) i64 {
    switch (s) {
        .dot => {
            return 0
        }
        .box => |b| {
            return b[2] * b[3]
        }
        .name => |n| {
            return @len(n)
        }
    }
}

fn first_of(o: ?[4]i64) i64 {
    if (o) |v| {
        return v[0]
    }
    return -1
}

fn len_of(o: ?[]u8) i64 {
    if (o) |s| {
        return @len(s)
    }
    return -1
}

fn port_of(addr: Addr) i64 {
    return addr.port()
}

const Mixer = struct {
    state: [8]u64
    last: [8]u64

    fn mix(inout self: Mixer, x: [8]u64) void {
        self.last = self.state
        self.state[0] = x[0]
    }

    fn total(self: Mixer) u64 {
        return self.state[0] + self.last[0]
    }

    fn sum_state(self: Mixer) u64 {
        return add_all(self.state)
    }
}

fn add_all(x: [8]u64) u64 {
    var s: u64 = 0
    for (x[0..]) |v| {
        s = s + v
    }
    return s
}

fn first(x: [8]u64, y: [8]u64) u64 {
    return x[0] + y[1]
}

fn make(v: u64) [8]u64 {
    var a: [8]u64 = @splat(v)
    a[1] = 4
    return a
}

fn bump(inout m: Mixer) [8]u64 {
    m.state[0] = m.state[0] + 100
    return m.state
}

fn report(io: Io, x: [8]u64) void {
    io.print(add_all(x))
}

fn count(b: Buf(i64)) i64 {
    return @len(b) + b[0]
}

fn main(io: Io, a: Allocator, threads: Threads, net: Net) !void {
    var m = Mixer{ .state = @splat(3), .last = @splat(1) }
    m.mix(m.last)
    io.print(m.last[0], " ", m.total())
    io.print(first(m.state, make(9)) + 5, " ", m.state[0], " ", first(make(3), m.last))
    // An argument evaluated before a later one changes its place.
    m = Mixer{ .state = @splat(4), .last = @splat(4) }
    const before = m.state
    io.print(add_all(before), " ", m.sum_state())
    io.print(first(m.state, bump(&m)))      // 4 + 4: m.state as it was; 108 + 4 had bump's change shown through
    // A function value, and a thread, with a big parameter.
    const f = add_all
    const small: [8]u64 = @splat(0)
    var three = small
    three[2] = 3
    io.print(f(three))
    threads.spawn(report, io, make(1)).join()
    // A borrowed Buf (24 bytes).
    var b = a.alloc(3, @as(i64, 6))
    defer a.free(b)
    io.print(count(b))
    b[0] = 1
    io.print(b[0], " ", count(b) - 1)
    // Arguments converted on the way in (to ?T) go through a temporary.
    io.print(area(Shape{ .box = [4]i64{ 0, 0, 3, 4 } }), " ", area(Shape{ .name = "abc" }), " ", area(.dot))
    const bytes: [5]u8 = @splat(1)
    io.print(first_of([4]i64{ 7, 0, 0, 0 }), " ", first_of(null), " ", len_of(bytes[1..]), " ", len_of(null))
    const addr = try net.resolve("127.0.0.1", 8080)
    io.print(port_of(addr))
}
