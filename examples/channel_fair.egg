// Threads blocked in send, or in recv, are served in the order they came:
// each sender queues while the channel is full, and the room a receiver
// leaves goes to the first of them, so a later one cannot cut in.
// expect: 0
// expect: 1
// expect: 2
// expect: 3
// expect: 4
// expect: 1 2 3 in order
// expect: receivers in order: 4
uses alloc, io, thread

const Worker = owned struct {
    t: Thread

    fn deinit(sink self: Worker) void {
        self.t.join()
        @forget(self)
    }
}

fn give(sink tx: Sender(i64), n: i64) void {
    defer tx.close()
    tx.send(n)
}

// Receiver n should get the value n.
fn take(sink rx: Receiver(i64), sink out: Sender(bool), n: i64) void {
    defer rx.close()
    defer out.close()
    if (rx.recv()) |v| {
        out.send(v == n)
    }
}

fn main(io: Io, a: Allocator, threads: Threads) void {
    // Nothing comes on idle: waiting on it gives each thread time to block.
    const idle = threads.channel(i64, 0)
    defer idle.close()
    const still = idle.sender()
    defer still.close()
    var pool: Buf(Worker) = .empty
    defer a.free(pool)

    const full = threads.channel(i64, 1)
    defer full.close()
    const first = full.sender()
    first.send(0)
    first.close()
    var i = 1
    while (i <= 4) {
        a.push(&pool, Worker{ .t = threads.spawn(give, full.sender(), i) })
        _ = idle.recv_timeout(50)
        i = i + 1
    }
    var got = 0
    while (got < 5) {
        if (full.recv()) |v| {
            io.print(v)
        }
        got = got + 1
    }

    // With capacity 0 the line is all there is: each send waits for its receiver.
    const meet = threads.channel(i64, 0)
    defer meet.close()
    i = 1
    while (i <= 3) {
        a.push(&pool, Worker{ .t = threads.spawn(give, meet.sender(), i) })
        _ = idle.recv_timeout(50)
        i = i + 1
    }
    const m1 = meet.recv() orelse 0
    const m2 = meet.recv() orelse 0
    const m3 = meet.recv() orelse 0
    io.print(m1, " ", m2, " ", m3, " in order")

    const jobs = threads.channel(i64, 1)
    defer jobs.close()
    const results = threads.channel(bool, 4)
    defer results.close()
    const feed = jobs.sender()
    i = 1
    while (i <= 4) {
        a.push(&pool, Worker{ .t = threads.spawn(take, jobs.clone(), results.sender(), i) })
        _ = idle.recv_timeout(50)
        i = i + 1
    }
    i = 1
    while (i <= 4) {
        feed.send(i)
        i = i + 1
    }
    feed.close()
    var right = 0
    while (results.recv()) |ok| {
        if (ok) { right = right + 1 }
    }
    io.print("receivers in order: ", right)
}
