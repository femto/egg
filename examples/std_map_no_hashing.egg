// Maps that never hash a key (made and counted), and a HashMap with its own
// hash, build without the SipHash helpers they do not use.
// expect: 0 0
// expect: 2
uses io, alloc, thread

const map = @import("std/map")

fn same_number(n: i64) i64 {
    return n
}

fn equal(x: i64, y: i64) bool {
    return x == y
}

fn main(io: Io, a: Allocator, threads: Threads) void {
    const m = map.HashMap(i64, i64).init()
    const c = threads.map(i64, i64)
    io.print(m.count(), " ", c.count())
    a.free(m)
    c.close()
    var own = map.HashMap(i64, i64).init_with(same_number, equal)
    defer a.free(own)
    own.put(a, 1, 2)
    io.print(own.get(1) orelse 0)
}
