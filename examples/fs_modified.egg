// stat's modified is when a file was last written, on the clock's scale.
// expect: true
// expect: true
// expect: true
uses alloc, fs, io

const time = @import("std/time")

fn main(io: Io, files: Fs, a: Allocator) !void {
    const before = time.now()
    try files.write("egg_modified.txt", "x")
    defer files.remove_file("egg_modified.txt") catch {}
    const st = try files.stat("egg_modified.txt")
    // File systems keep coarser times than the clock (FAT two seconds),
    // and may be on another machine's clock: a minute either way.
    io.print(st.modified > before - 60000000000 and st.modified < time.now() + 60000000000)
    try files.make_dir("egg_modified_dir")
    defer files.remove_dir("egg_modified_dir") catch {}
    const d = try files.stat("egg_modified_dir")
    io.print(d.modified > before - 60000000000)
    // Reading a file does not change it.
    const text = try files.read(a, "egg_modified.txt")
    a.free(text)
    const again = try files.stat("egg_modified.txt")
    io.print(again.modified == st.modified)
}
