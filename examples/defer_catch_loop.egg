// In a defer, a catch block may hold a loop whose own catch break and
// catch continue stay inside that loop; only leaving the defer is E118.
// expect: 0
// expect: 1
// expect: 2
// expect: 3
uses io
fn f(x: i64) !i64 {
    if (x == 0) { return error.Zero }
    return x
}
fn g() !void {
    return error.Closed
}
fn h(out: Io) !void {
    defer g() catch {
        var i: i64 = 0
        while (i < 3) {
            i = i + 1
            const v = f(i) catch continue
            const w = f(v) catch break
            out.print(w)
        }
    }
    out.print(0)
}
fn main(out: Io) void {
    h(out) catch |_| {
        out.print(9)
    }
}
