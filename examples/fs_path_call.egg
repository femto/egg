// The path is computed by a call, so the allocator before it is evaluated first.
// expect: NotFound
uses alloc, fs, io

fn path(a: Allocator) str {
    return a.leak("/nonexistent/egg/file")
}

fn main(io: Io, files: Fs, a: Allocator) void {
    const b = files.read(a, path(a)) catch |e| {
        io.print(@errorName(e))
        return
    }
    a.free(b)
}
