{
  "name": "egg-lang",
  "displayName": "Egg",
  "description": "Syntax highlighting and breakpoints for the Egg programming language",
  "version": "0.0.2",
  "publisher": "femto",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/femto/egg" },
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages", "Debuggers"],
  "contributes": {
    "languages": [
      {
        "id": "egg",
        "aliases": ["Egg", "egg"],
        "extensions": [".egg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "egg",
        "scopeName": "source.egg",
        "path": "./syntaxes/egg.tmLanguage.json"
      }
    ],
    "breakpoints": [{ "language": "egg" }]
  }
}
