{
  "name": "egg-lang",
  "displayName": "Egg",
  "description": "Syntax highlighting for the Egg programming language",
  "version": "0.0.1",
  "publisher": "femto",
  "license": "MIT",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "egg",
        "aliases": ["Egg", "egg"],
        "extensions": [".egg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "egg",
        "scopeName": "source.egg",
        "path": "./syntaxes/egg.tmLanguage.json"
      }
    ]
  }
}
